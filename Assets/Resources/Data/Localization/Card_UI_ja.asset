    m_Metadata:
      m_Items: []
  - m_Id: 174172389302251538
    m_Localized: "\u5FA9\u5143\u53EF\u80FD\u306A PLAYER ID \u3068\u533F\u540D\u30AF\u30E9\u30A6\u30C9\u30B5\u30FC\u30D3\u30B9\u306E\u72B6\u614B\u306F\u5225\u3005\u3067\u3059\u3002"
