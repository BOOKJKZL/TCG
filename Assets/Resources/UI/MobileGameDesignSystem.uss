@import url("CoreNeutralTokens.uss");

.mobile-design-system {
    color: var(--ui-text);
}

.mobile-page {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: var(--ui-text);
    background-color: var(--ui-canvas);
}

.mobile-page__safe-area {
    flex-grow: 1;
    min-height: 0;
    width: 100%;
    padding: 24px;
}

.mobile-page__header-slot,
.mobile-page__bottom-slot {
    flex-shrink: 0;
}

.mobile-page__content-slot {
    flex-grow: 1;
    min-height: 0;
}

.mobile-page__overlay-layer,
.mobile-page__modal-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.mobile-top-bar {
    min-height: 82px;
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    border-width: 1px;
    border-radius: 18px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
}

.mobile-top-bar__leading {
    display: none;
}

.mobile-top-bar__copy {
    flex-grow: 1;
    min-width: 0;
}

.mobile-top-bar__title {
    color: var(--ui-text);
    font-size: 28px;
    -unity-font-style: bold;
    white-space: normal;
}

.mobile-top-bar__subtitle {
    margin-top: 3px;
    color: var(--ui-text-secondary);
    font-size: 15px;
    white-space: normal;
}

.mobile-top-bar__subtitle.is-empty,
.mobile-sheet__body.is-empty {
    display: none;
}

.mobile-top-bar__actions {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin-left: 10px;
}

.mobile-top-bar__action {
    min-width: 112px;
    margin-left: 8px;
}

.mobile-action {
    position: relative;
    min-width: 112px;
    min-height: 50px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
}

.mobile-action--primary {
    border-color: var(--ui-primary);
    background-color: var(--ui-primary);
}

.mobile-action--quiet,
.mobile-action--navigation {
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
}

.mobile-action--danger {
    border-color: var(--ui-error);
    background-color: var(--ui-error);
}

.mobile-action__focus-ring {
    position: absolute;
    left: 3px;
    right: 3px;
    top: 3px;
    bottom: 3px;
    display: none;
    border-width: 2px;
    border-radius: 10px;
    border-color: var(--ui-primary);
}

.mobile-action--primary .mobile-action__focus-ring,
.mobile-action--danger .mobile-action__focus-ring {
    border-color: var(--ui-on-primary);
}

.mobile-action:focus .mobile-action__focus-ring {
    display: flex;
}

.mobile-action__selection-indicator {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 4px;
    height: 3px;
    display: none;
    border-radius: 2px;
    background-color: var(--ui-primary);
}

.mobile-action--primary .mobile-action__selection-indicator,
.mobile-action--danger .mobile-action__selection-indicator {
    background-color: var(--ui-on-primary);
}

.mobile-action__selection-indicator.is-selected {
    display: flex;
}

.mobile-action__label,
.mobile-action__loading {
    width: 100%;
    flex-shrink: 0;
    color: var(--ui-text);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.mobile-action__label {
    visibility: visible;
}

.mobile-action--primary .mobile-action__label,
.mobile-action--primary .mobile-action__loading,
.mobile-action--danger .mobile-action__label,
.mobile-action--danger .mobile-action__loading {
    color: var(--ui-on-primary);
}

.mobile-action__label.is-pressed {
    color: var(--ui-primary);
    translate: 0 1px;
}

.mobile-action--primary .mobile-action__label.is-pressed {
    color: var(--ui-primary-soft);
}

.mobile-action--danger .mobile-action__label.is-pressed {
    color: var(--ui-error-surface);
}

.mobile-action__label.is-disabled {
    color: var(--ui-text-secondary);
    -unity-font-style: normal;
}

.mobile-action--primary .mobile-action__label.is-disabled {
    color: var(--ui-primary-soft);
}

.mobile-action--danger .mobile-action__label.is-disabled {
    color: var(--ui-error-surface);
}

.mobile-action__label.is-loading {
    visibility: hidden;
}

.mobile-action__loading {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
}

.mobile-action__loading.is-visible {
    display: flex;
}

.mobile-bottom-navigation {
    min-height: 72px;
    flex-direction: row;
    align-items: stretch;
    margin-top: 12px;
    padding: 8px;
    border-width: 1px;
    border-radius: 18px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
}

.mobile-bottom-navigation__item {
    flex-grow: 1;
    min-width: 0;
    min-height: 56px;
    margin-left: 4px;
    margin-right: 4px;
}

.mobile-card,
.mobile-state-card,
.mobile-progress {
    margin-top: 12px;
    padding: 18px;
    border-width: 1px;
    border-radius: 18px;
    color: var(--ui-text);
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
}

.mobile-card__header,
.mobile-card__footer,
.mobile-state-card__actions,
.mobile-progress__header,
.mobile-sheet__actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.mobile-card__body {
    flex-grow: 1;
    margin-top: 10px;
}

.mobile-card__footer {
    margin-top: 12px;
}

.mobile-state-card {
    min-height: 210px;
    align-items: center;
    justify-content: center;
}

.mobile-state-card__icon {
    color: var(--ui-primary);
    font-size: 34px;
    -unity-text-align: middle-center;
}

.mobile-state-card__title {
    margin-top: 8px;
    color: var(--ui-text);
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.mobile-state-card__body {
    margin-top: 8px;
    max-width: 680px;
    color: var(--ui-text-secondary);
    font-size: 17px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.mobile-state-card__actions {
    justify-content: center;
    margin-top: 16px;
}

.mobile-state-card__actions .mobile-action {
    width: 100%;
}

.mobile-state-card__action-slot {
    margin: 4px;
}

.mobile-error-state {
    border-width: 2px;
    border-color: var(--ui-error);
    background-color: var(--ui-error-surface);
}

.mobile-error-state .mobile-state-card__icon,
.mobile-error-state .mobile-state-card__title,
.mobile-error-state .mobile-state-card__body {
    color: var(--ui-error);
}

.mobile-progress__header {
    justify-content: space-between;
}

.mobile-progress__label,
.mobile-progress__value {
    color: var(--ui-text);
    font-size: 16px;
    white-space: normal;
}

.mobile-progress__label {
    flex-grow: 1;
    white-space: normal;
}

.mobile-progress__value {
    margin-left: 10px;
    -unity-font-style: bold;
}

.mobile-progress__bar {
    height: 26px;
    margin-top: 10px;
}

.mobile-progress__bar .unity-progress-bar__background {
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
}

.mobile-progress__bar .unity-progress-bar__progress {
    border-radius: 5px;
    background-color: var(--ui-primary);
}

/* The separate value label remains readable regardless of the fill amount. */
.mobile-progress__bar .unity-progress-bar__title {
    display: none;
}

.mobile-toast {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 96px;
    min-height: 50px;
    padding: 12px 16px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
}

.mobile-toast--success {
    border-color: var(--ui-success);
    background-color: var(--ui-success-surface);
}

.mobile-toast--warning {
    border-color: var(--ui-warning);
    background-color: var(--ui-warning-surface);
}

.mobile-toast--error {
    border-color: var(--ui-error);
    background-color: var(--ui-error-surface);
}

.mobile-toast__label {
    color: var(--ui-text);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.mobile-toast--success .mobile-toast__label {
    color: var(--ui-success);
}

.mobile-toast--warning .mobile-toast__label {
    color: var(--ui-warning);
}

.mobile-toast--error .mobile-toast__label {
    color: var(--ui-error);
}

.mobile-sheet {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.mobile-sheet__scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--ui-scrim);
}

.mobile-sheet__safe-area {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: flex-end;
    padding: 16px;
}

.mobile-sheet__panel {
    width: 100%;
    max-width: 760px;
    max-height: 82%;
    min-height: 0;
    flex-shrink: 1;
    align-self: center;
    padding: 20px;
    border-width: 1px;
    border-radius: 18px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
}

/* Keep the complete reading order scrollable, including the final actions. */
.mobile-sheet__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.mobile-sheet__scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding-right: 4px;
    padding-bottom: 4px;
}

.mobile-sheet__scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container > VisualElement,
.mobile-sheet__scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container > Label {
    flex-shrink: 0;
}

.mobile-sheet__grabber {
    width: 58px;
    height: 5px;
    align-self: center;
    margin-bottom: 14px;
    border-radius: 3px;
    background-color: var(--ui-outline);
}

.mobile-sheet__title {
    color: var(--ui-text);
    font-size: 25px;
    -unity-font-style: bold;
    white-space: normal;
}

.mobile-sheet__body {
    margin-top: 8px;
    color: var(--ui-text-secondary);
    font-size: 17px;
    white-space: normal;
}

.mobile-sheet__content {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 0;
    margin-top: 12px;
}

.mobile-sheet__actions {
    flex-shrink: 0;
    justify-content: flex-end;
    margin-top: 16px;
}

.mobile-sheet__actions .mobile-action {
    width: 100%;
}

.mobile-sheet__action-slot {
    margin-left: 8px;
    margin-top: 4px;
}

.mobile-layout--compact .mobile-top-bar {
    flex-direction: column;
    align-items: stretch;
    flex-wrap: nowrap;
    flex-shrink: 0;
}

.mobile-layout--compact .mobile-top-bar__copy {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
}

.mobile-layout--compact .mobile-top-bar__actions {
    width: 100%;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 0;
    margin-top: 8px;
}

.mobile-layout--compact .mobile-top-bar__action {
    flex-grow: 1;
    margin-left: 4px;
    margin-right: 4px;
}

.mobile-layout--compact .mobile-bottom-navigation {
    min-height: 68px;
    padding: 6px;
}

.mobile-layout--compact .mobile-bottom-navigation__item {
    min-width: 0;
    padding-left: 6px;
    padding-right: 6px;
    margin-left: 2px;
    margin-right: 2px;
}

.mobile-layout--compact .mobile-state-card__actions,
.mobile-layout--compact .mobile-sheet__actions {
    flex-direction: column;
    align-items: stretch;
}

.mobile-layout--compact .mobile-state-card__actions .mobile-action,
.mobile-layout--compact .mobile-sheet__actions .mobile-action {
    width: 100%;
}

.mobile-layout--compact .mobile-state-card__action-slot,
.mobile-layout--compact .mobile-sheet__action-slot {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
}

.reduce-motion .mobile-toast,
.reduce-motion .mobile-sheet__panel,
.reduce-motion .mobile-error-state {
    transition-duration: 0s;
}
