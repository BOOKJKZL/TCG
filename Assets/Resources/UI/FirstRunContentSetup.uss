@import url("CoreNeutralTokens.uss");

.first-run-content {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 30px;
}

.first-run-content__scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--ui-scrim);
}

.first-run-content__panel {
    width: 720px;
    max-width: 100%;
    max-height: 100%;
    flex-shrink: 1;
    padding: 34px;
    border-width: 2px;
    border-radius: 24px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
}

.first-run-content__panel .unity-scroll-view__content-container {
    flex-shrink: 0;
}

.first-run-content__kicker,
.first-run-content__label {
    color: var(--ui-primary);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.first-run-content__title {
    margin-top: 8px;
    color: var(--ui-text);
    font-size: 34px;
    -unity-font-style: bold;
    white-space: normal;
}

.first-run-content__body,
.first-run-content__detail {
    margin-top: 14px;
    color: var(--ui-text-secondary);
    font-size: 19px;
    white-space: normal;
}

.first-run-content__detail--compact {
    margin-top: 6px;
    color: var(--ui-text-secondary);
    font-size: 17px;
}

.first-run-content__label {
    margin-top: 22px;
}

.first-run-content__languages,
.first-run-content__actions {
    margin-top: 12px;
    flex-direction: row;
    flex-wrap: wrap;
}

.first-run-content__button {
    min-height: 52px;
    min-width: 150px;
    margin-right: 10px;
    margin-bottom: 10px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
    overflow: hidden;
}

.first-run-content__button-label {
    flex-grow: 1;
    min-height: 50px;
    padding: 10px 14px;
    color: var(--ui-text);
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-center;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.first-run-content__button-label.is-pressed {
    color: var(--ui-primary);
    background-color: var(--ui-primary-soft);
}

.first-run-content__button-label.is-disabled {
    color: var(--ui-text-secondary);
}

.first-run-content__button:focus .first-run-content__button-label {
    color: var(--ui-primary);
}

.first-run-content__button--primary {
    background-color: var(--ui-primary);
}

.first-run-content__button--quiet {
    background-color: var(--ui-raised);
}

.first-run-content__button-label.is-selected {
    border-color: var(--ui-primary);
}

.first-run-content__button--primary .first-run-content__button-label {
    color: var(--ui-on-primary);
}

.first-run-content__button--primary .first-run-content__button-label.is-pressed,
.first-run-content__button--primary .first-run-content__button-label.is-disabled,
.first-run-content__button--primary:focus .first-run-content__button-label {
    color: var(--ui-primary-soft);
    background-color: var(--ui-primary);
}

.first-run-content__button:focus .first-run-content__button-label {
    border-color: var(--ui-primary);
}

.first-run-content__button--primary:focus .first-run-content__button-label {
    border-color: var(--ui-on-primary);
}

.first-run-content__recommendation {
    display: none;
    margin-top: 18px;
    padding: 18px;
    border-width: 2px;
    border-radius: 18px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
}

.first-run-content__recommendation-name {
    margin-top: 6px;
    color: var(--ui-text);
    font-size: 23px;
    -unity-font-style: bold;
    white-space: normal;
}

.first-run-content__recommendation .first-run-content__button {
    margin-top: 14px;
    margin-right: 0;
}
