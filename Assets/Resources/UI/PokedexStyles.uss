.pokedex-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 28px;
    color: rgb(240, 247, 255);
    background-color: rgba(3, 8, 18, 0.97);
}

.pokedex-device-rail {
    height: 8px;
    flex-shrink: 0;
    flex-direction: row;
    margin-left: -26px;
    margin-right: -26px;
    margin-top: -26px;
    margin-bottom: 18px;
    overflow: hidden;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
}

.pokedex-device-rail__red {
    flex-grow: 5;
    background-color: rgb(235, 74, 80);
}

.pokedex-device-rail__yellow {
    flex-grow: 2;
    background-color: rgb(255, 211, 65);
}

.pokedex-device-rail__blue {
    flex-grow: 3;
    background-color: rgb(52, 137, 214);
}

.pokedex-status-lights {
    width: 104px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-right: 16px;
}

.pokedex-status-light {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    margin-left: 5px;
    border-width: 2px;
    border-radius: 6px;
    border-color: rgba(255, 255, 255, 0.72);
}

.pokedex-status-light--lens {
    width: 38px;
    height: 38px;
    margin-left: 0;
    margin-right: 4px;
    border-width: 4px;
    border-radius: 21px;
    border-color: rgb(235, 249, 255);
    background-color: rgb(66, 204, 241);
}

.pokedex-status-light--red {
    background-color: rgb(240, 74, 81);
}

.pokedex-status-light--yellow {
    background-color: rgb(255, 211, 65);
}

.pokedex-status-light--green {
    background-color: rgb(78, 203, 128);
}

.pokedex-shell {
    flex-grow: 1;
    width: 100%;
    max-width: 1080px;
    align-self: center;
    padding: 26px;
    border-width: 2px;
    border-radius: 28px;
    border-color: rgba(113, 216, 180, 0.8);
    background-color: rgb(14, 29, 42);
}

.pokedex-header,
.pokedex-filters,
.pokedex-row,
.pokedex-detail__hero,
.pokedex-form-strip {
    flex-direction: row;
    align-items: center;
}

.pokedex-heading,
.pokedex-row__copy,
.pokedex-detail__copy {
    flex-grow: 1;
}

.pokedex-title {
    color: rgb(250, 255, 252);
    font-size: 36px;
    -unity-font-style: bold;
}

.pokedex-subtitle,
.pokedex-status,
.pokedex-row__genus,
.pokedex-detail__genus,
.pokedex-detail__metadata {
    color: rgb(161, 199, 193);
    font-size: 16px;
}

.pokedex-page,
.pokedex-list {
    flex-grow: 1;
}

.pokedex-filters {
    margin-top: 18px;
    margin-bottom: 10px;
    padding: 12px;
    border-width: 1px;
    border-radius: 16px;
    border-color: rgba(100, 184, 161, 0.55);
    background-color: rgba(21, 48, 58, 0.9);
}

.pokedex-field {
    color: rgb(213, 235, 230);
    font-size: 14px;
}

.pokedex-field .unity-base-text-field__input,
.pokedex-field .unity-base-popup-field__input {
    min-height: 38px;
    border-width: 1px;
    border-radius: 10px;
    border-color: rgba(113, 216, 180, 0.65);
    background-color: rgb(8, 24, 33);
    color: white;
}

.pokedex-generation {
    width: 260px;
    margin-right: 14px;
}

.pokedex-search {
    flex-grow: 1;
}

.pokedex-status {
    margin-top: 4px;
    margin-bottom: 8px;
}

.pokedex-status.is-error {
    color: rgb(255, 145, 150);
}

.pokedex-error-panel {
    margin-top: 12px;
    margin-bottom: 12px;
    padding: 18px;
    border-width: 2px;
    border-radius: 14px;
    border-color: rgb(223, 105, 96);
    background-color: rgba(73, 28, 34, 0.96);
}

.pokedex-error-panel__title {
    color: rgb(255, 224, 214);
    font-size: 22px;
    -unity-font-style: bold;
    white-space: normal;
}

.pokedex-error-panel__body {
    margin-top: 8px;
    color: rgb(245, 224, 219);
    font-size: 18px;
    white-space: normal;
}

.pokedex-error-panel__actions {
    margin-top: 12px;
    flex-direction: row;
    flex-wrap: wrap;
}

.pokedex-empty {
    flex-grow: 1;
    padding: 30px;
    color: rgb(161, 199, 193);
    font-size: 19px;
    -unity-text-align: middle-center;
}

.pokedex-row {
    height: 100%;
    margin: 4px 7px;
    padding: 10px 16px;
    border-width: 1px;
    border-radius: 16px;
    border-color: rgba(90, 151, 147, 0.55);
    background-color: rgb(24, 49, 59);
    transition-property: scale, background-color, border-color;
    transition-duration: 0.12s;
}

.pokedex-form-row {
    height: 100%;
    margin: 3px 7px;
    padding: 8px 14px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-radius: 14px;
    border-color: rgba(255, 204, 102, 0.58);
    background-color: rgb(54, 51, 47);
}

.pokedex-introduced-forms {
    height: 205px;
    margin-bottom: 10px;
    padding: 10px;
    border-width: 1px;
    border-radius: 16px;
    border-color: rgba(255, 204, 102, 0.52);
    background-color: rgba(45, 39, 34, 0.94);
}

.pokedex-introduced-forms__heading {
    margin-bottom: 6px;
    color: rgb(255, 220, 135);
    font-size: 18px;
    -unity-font-style: bold;
}

.pokedex-introduced-forms__list {
    flex-grow: 1;
}

.pokedex-row:hover {
    scale: 1.01 1.01;
    border-color: rgb(117, 226, 189);
    background-color: rgb(31, 65, 72);
}

.pokedex-row__number {
    width: 86px;
    color: rgb(255, 218, 111);
    font-size: 23px;
    -unity-font-style: bold;
}

.pokedex-row__name {
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
}

.pokedex-button,
.pokedex-form-button {
    min-width: 128px;
    height: 48px;
    padding-left: 16px;
    padding-right: 16px;
    border-width: 1px;
    border-radius: 14px;
    border-color: rgb(117, 226, 189);
    background-color: rgb(33, 126, 104);
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.pokedex-button:active,
.pokedex-form-button:active {
    scale: 0.96 0.96;
}

.pokedex-button--quiet {
    background-color: rgb(38, 67, 76);
}

.pokedex-detail {
    margin-top: 14px;
}

.pokedex-detail__back {
    align-self: flex-start;
    margin-bottom: 14px;
}

.pokedex-detail__hero {
    align-items: flex-start;
}

.pokedex-artwork {
    width: 300px;
    height: 300px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-width: 2px;
    border-radius: 28px;
    border-color: rgba(117, 226, 189, 0.75);
    background-color: rgb(8, 24, 33);
}

.pokedex-artwork__number {
    color: rgba(117, 226, 189, 0.26);
    font-size: 68px;
    -unity-font-style: bold;
}

.pokedex-art-slot {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.pokedex-artwork .async-card-image {
    width: 100%;
    height: 100%;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.pokedex-artwork .async-card-image__status {
    top: 126px;
    left: 24px;
    right: 24px;
    font-size: 14px;
}

.pokedex-artwork .async-card-image__retry {
    left: 72px;
    right: 72px;
    bottom: 36px;
    height: 38px;
}

.pokedex-artwork__status {
    max-width: 230px;
    margin-top: 18px;
    color: rgb(161, 199, 193);
    white-space: normal;
    -unity-text-align: middle-center;
}

.pokedex-detail__copy {
    margin-left: 28px;
}

.pokedex-detail__number {
    color: rgb(255, 218, 111);
    font-size: 18px;
    -unity-font-style: bold;
}

.pokedex-detail__name {
    margin-top: 4px;
    color: white;
    font-size: 42px;
    -unity-font-style: bold;
}

.pokedex-detail__genus {
    margin-bottom: 18px;
    font-size: 19px;
}

.pokedex-detail__metadata {
    margin-top: 5px;
}

.pokedex-detail__description {
    margin-top: 20px;
    color: rgb(225, 239, 237);
    font-size: 19px;
    white-space: normal;
}

.pokedex-section {
    margin-top: 22px;
    padding: 18px;
    border-width: 1px;
    border-radius: 18px;
    border-color: rgba(90, 151, 147, 0.55);
    background-color: rgba(20, 43, 52, 0.94);
}

.pokedex-section__heading {
    margin-bottom: 12px;
    color: white;
    font-size: 23px;
    -unity-font-style: bold;
}

.pokedex-form-button {
    margin-right: 10px;
    background-color: rgb(39, 72, 80);
}

.pokedex-form-button.is-selected {
    border-color: rgb(255, 218, 111);
    background-color: rgb(119, 88, 28);
    color: rgb(255, 244, 204);
}

.pokedex-card-count {
    color: rgb(161, 199, 193);
    font-size: 18px;
}

.pokedex-card-controls,
.pokedex-card-filters,
.pokedex-card-row {
    flex-direction: row;
    align-items: center;
}

.pokedex-card-controls {
    margin-top: 12px;
    margin-bottom: 10px;
}

.pokedex-manage-button {
    margin-left: auto;
}

.pokedex-card-filters {
    margin-bottom: 8px;
}

.pokedex-card-search {
    flex-grow: 1;
    margin-right: 12px;
}

.pokedex-card-sort {
    width: 230px;
}

.pokedex-card-list {
    height: 410px;
}

.pokedex-card-empty {
    min-height: 120px;
}

.pokedex-card-row {
    height: 100%;
    margin: 4px 6px;
    padding: 10px 14px;
    border-width: 1px;
    border-radius: 16px;
    border-color: rgba(90, 151, 147, 0.55);
    background-color: rgb(24, 49, 59);
}

.pokedex-card-row.is-not-installed {
    opacity: 0.68;
}

.pokedex-card-row__copy {
    flex-grow: 1;
    margin-left: 14px;
}

.pokedex-card-row__name {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
}

.pokedex-card-row__metadata,
.pokedex-card-row__status {
    color: rgb(161, 199, 193);
    font-size: 14px;
}

.pokedex-card-row__status {
    width: 170px;
    white-space: normal;
    -unity-text-align: middle-right;
}

.pokedex-card-row .async-card-image {
    width: 88px;
    height: 122px;
}

.reduce-motion .pokedex-row,
.reduce-motion .pokedex-button,
.reduce-motion .pokedex-form-button {
    transition-duration: 0s;
}

/* Original handheld Pokédex-inspired device treatment; no official UI assets. */
.pokedex-overlay {
    background-color: rgb(7, 19, 39);
}

.pokedex-shell {
    border-color: rgb(247, 103, 110);
    background-color: rgb(181, 43, 54);
}

.pokedex-page {
    padding: 14px;
    border-radius: 18px;
    background-color: rgb(242, 247, 250);
}

.pokedex-title {
    color: white;
}

.pokedex-subtitle {
    color: rgb(255, 213, 216);
}

.pokedex-status,
.pokedex-empty,
.pokedex-card-count {
    color: rgb(72, 98, 122);
}

.pokedex-filters {
    border-color: rgb(81, 165, 221);
    background-color: rgb(17, 48, 82);
}

.pokedex-field {
    color: rgb(218, 237, 250);
}

.pokedex-field .unity-base-text-field__input,
.pokedex-field .unity-base-popup-field__input {
    border-color: rgb(88, 176, 229);
    background-color: rgb(8, 31, 57);
}

.pokedex-row,
.pokedex-card-row {
    border-color: rgb(184, 202, 216);
    background-color: rgb(255, 255, 255);
}

.pokedex-row:hover,
.pokedex-card-row:hover {
    border-color: rgb(67, 157, 221);
    background-color: rgb(222, 239, 249);
}

.pokedex-row__name,
.pokedex-card-row__name {
    color: rgb(21, 43, 67);
}

.pokedex-row__genus,
.pokedex-card-row__metadata,
.pokedex-card-row__status {
    color: rgb(74, 101, 126);
}

.pokedex-row__number {
    color: rgb(205, 49, 61);
}

.pokedex-form-row,
.pokedex-introduced-forms {
    border-color: rgb(226, 169, 48);
    background-color: rgb(255, 246, 211);
}

.pokedex-introduced-forms__heading {
    color: rgb(135, 92, 18);
}

.pokedex-button,
.pokedex-form-button {
    border-color: rgb(103, 196, 241);
    background-color: rgb(43, 118, 190);
}

.pokedex-button--quiet {
    border-color: rgb(218, 231, 240);
    background-color: rgb(48, 76, 102);
}

.pokedex-detail__hero,
.pokedex-section {
    border-color: rgb(184, 202, 216);
    background-color: rgb(255, 255, 255);
}

.pokedex-detail__hero {
    padding: 18px;
    border-width: 1px;
    border-radius: 18px;
}

.pokedex-detail__number {
    color: rgb(205, 49, 61);
}

.pokedex-detail__name,
.pokedex-section__heading {
    color: rgb(21, 43, 67);
}

.pokedex-detail__genus,
.pokedex-detail__metadata {
    color: rgb(74, 101, 126);
}

.pokedex-detail__description {
    color: rgb(38, 63, 86);
}

.pokedex-form-button.is-selected {
    border-color: rgb(230, 177, 55);
    background-color: rgb(205, 49, 61);
    color: white;
}

.pokedex-overlay.mobile-layout--compact .pokedex-shell {
    padding: 18px;
}

.pokedex-overlay.mobile-layout--compact .pokedex-header,
.pokedex-overlay.mobile-layout--compact .pokedex-card-controls,
.pokedex-overlay.mobile-layout--compact .pokedex-card-filters {
    flex-wrap: wrap;
}

.pokedex-overlay.mobile-layout--compact .pokedex-filters,
.pokedex-overlay.mobile-layout--compact .pokedex-detail__hero {
    flex-direction: column;
    align-items: stretch;
}

.pokedex-overlay.mobile-layout--compact .pokedex-field,
.pokedex-overlay.mobile-layout--compact .pokedex-generation,
.pokedex-overlay.mobile-layout--compact .pokedex-search,
.pokedex-overlay.mobile-layout--compact .pokedex-card-search,
.pokedex-overlay.mobile-layout--compact .pokedex-card-sort {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-left: 0;
    margin-right: 0;
    margin-top: 6px;
}

.pokedex-overlay.mobile-layout--compact .pokedex-artwork {
    width: 220px;
    height: 220px;
    align-self: center;
}
