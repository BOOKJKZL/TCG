.pokedex-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.pokedex-body,
.pokedex-page,
.pokedex-list,
.pokedex-card-list {
    flex-grow: 1;
    min-height: 0;
}

.pokedex-body {
    padding-top: 8px;
}

.pokedex-page {
    width: 100%;
}

.pokedex-filters,
.pokedex-detail__hero,
.pokedex-form-strip,
.pokedex-card-controls,
.pokedex-card-filters,
.pokedex-species-grid-row,
.pokedex-card-grid-row,
.pokedex-form-row,
.pokedex-card-tile {
    flex-direction: row;
}

.pokedex-filters {
    flex-shrink: 0;
    align-items: flex-end;
    margin-bottom: 10px;
    padding: 12px;
}

.pokedex-field {
    color: rgb(218, 237, 250);
    font-size: 15px;
}

.pokedex-field .unity-base-text-field__input,
.pokedex-field .unity-base-popup-field__input {
    min-height: 48px;
    border-width: 1px;
    border-radius: 12px;
    border-color: rgb(88, 176, 229);
    background-color: rgb(8, 31, 57);
    color: white;
}

.pokedex-generation {
    width: 300px;
    margin-right: 12px;
}

.pokedex-search,
.pokedex-card-search {
    flex-grow: 1;
}

.pokedex-status,
.pokedex-card-count,
.pokedex-row__genus,
.pokedex-card-row__metadata,
.pokedex-card-row__status,
.pokedex-detail__genus,
.pokedex-detail__metadata {
    color: rgb(148, 181, 207);
    font-size: 15px;
    white-space: normal;
}

.pokedex-status {
    min-height: 24px;
    margin: 2px 4px 8px 4px;
}

.pokedex-status.is-error {
    color: rgb(255, 150, 157);
}

.pokedex-empty-state,
.pokedex-card-empty-state {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    padding: 20px;
    border-width: 1px;
    border-radius: 18px;
    border-color: rgba(90, 151, 188, 0.65);
    background-color: rgba(16, 39, 62, 0.96);
}

.pokedex-empty {
    color: rgb(184, 211, 229);
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.pokedex-empty-state .pokedex-action {
    margin-top: 12px;
}

.pokedex-introduced-forms {
    height: 204px;
    flex-shrink: 0;
    margin-bottom: 10px;
    padding: 10px;
    border-width: 1px;
    border-radius: 18px;
    border-color: rgba(230, 177, 55, 0.7);
    background-color: rgba(72, 55, 21, 0.9);
}

.pokedex-introduced-forms__heading {
    margin: 2px 4px 8px 4px;
    color: rgb(255, 220, 135);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.pokedex-introduced-forms__list {
    flex-grow: 1;
    min-height: 0;
}

.pokedex-species-grid-row {
    min-height: 112px;
    align-items: stretch;
}

.pokedex-species-tile,
.pokedex-form-row,
.pokedex-card-tile {
    border-width: 1px;
    border-radius: 16px;
    border-color: rgb(61, 111, 151);
    background-color: rgb(19, 48, 75);
}

.pokedex-species-tile {
    width: 50%;
    min-height: 104px;
    margin: 4px;
    padding: 12px 14px;
    justify-content: center;
}

.pokedex-species-tile.is-hidden {
    display: none;
}

.pokedex-row__number {
    color: rgb(255, 211, 92);
    font-size: 17px;
    -unity-font-style: bold;
}

.pokedex-row__name,
.pokedex-card-row__name {
    margin-top: 3px;
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
}

.pokedex-action {
    min-width: 112px;
    min-height: 50px;
    padding: 10px 16px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-radius: 14px;
    border-color: rgb(90, 177, 227);
    background-color: rgb(35, 91, 143);
}

.pokedex-action--primary {
    border-color: rgb(255, 211, 92);
    background-color: rgb(190, 49, 61);
}

.pokedex-action--quiet {
    border-color: rgb(83, 124, 157);
    background-color: rgb(31, 62, 89);
}

.pokedex-action__label {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.pokedex-action__label.is-pressed,
.pokedex-row__name.is-pressed,
.pokedex-card-row__name.is-pressed {
    color: rgb(255, 224, 112);
}

.pokedex-action__label.is-disabled,
.pokedex-row__name.is-disabled,
.pokedex-card-row__name.is-disabled {
    color: rgba(185, 202, 216, 0.55);
}

.pokedex-species-tile:focus .pokedex-row__name,
.pokedex-form-row:focus .pokedex-row__name,
.pokedex-card-tile:focus .pokedex-card-row__name,
.pokedex-action:focus .pokedex-action__label {
    color: rgb(255, 221, 103);
}

.pokedex-action:focus .pokedex-action__label.is-disabled {
    color: rgba(185, 202, 216, 0.55);
}

.pokedex-form-row {
    min-height: 72px;
    margin: 3px 5px;
    padding: 9px 14px;
    align-items: center;
}

.pokedex-form-row .pokedex-row__number {
    width: 72px;
    flex-shrink: 0;
}

.pokedex-row__copy,
.pokedex-card-row__copy,
.pokedex-detail__copy,
.pokedex-related-heading {
    flex-grow: 1;
    min-width: 0;
}

.pokedex-detail__back {
    align-self: flex-start;
    flex-shrink: 0;
    margin-bottom: 10px;
}

.pokedex-detail__hero {
    height: 310px;
    flex-shrink: 0;
    align-items: stretch;
    padding: 14px;
}

.pokedex-artwork {
    width: 270px;
    height: 270px;
    flex-shrink: 0;
    align-self: center;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-width: 1px;
    border-radius: 22px;
    border-color: rgba(91, 181, 231, 0.8);
    background-color: rgb(8, 27, 46);
}

.pokedex-art-slot {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.pokedex-artwork__number {
    color: rgba(91, 181, 231, 0.3);
    font-size: 64px;
    -unity-font-style: bold;
}

.pokedex-artwork__status {
    max-width: 220px;
    color: rgb(148, 181, 207);
    white-space: normal;
    -unity-text-align: middle-center;
}

.pokedex-artwork .async-card-image {
    width: 100%;
    height: 100%;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.pokedex-artwork .async-card-image__status {
    top: 110px;
    left: 22px;
    right: 22px;
}

.pokedex-artwork .async-card-image__retry {
    left: 54px;
    right: 54px;
    bottom: 28px;
    min-height: 48px;
}

.pokedex-detail__copy-scroll {
    flex-grow: 1;
    min-width: 0;
    margin-left: 20px;
}

.pokedex-detail__number {
    color: rgb(255, 211, 92);
    font-size: 17px;
    -unity-font-style: bold;
}

.pokedex-detail__name {
    margin-top: 3px;
    color: white;
    font-size: 36px;
    -unity-font-style: bold;
    white-space: normal;
}

.pokedex-detail__genus {
    margin-bottom: 12px;
    font-size: 18px;
}

.pokedex-detail__metadata {
    margin-top: 4px;
}

.pokedex-detail__description {
    margin-top: 14px;
    color: rgb(224, 238, 247);
    font-size: 17px;
    white-space: normal;
}

.pokedex-section,
.pokedex-related-header {
    flex-shrink: 0;
    margin-top: 10px;
    padding: 12px;
}

.pokedex-section {
    border-width: 1px;
    border-radius: 16px;
    border-color: rgba(78, 135, 176, 0.72);
    background-color: rgb(16, 39, 62);
}

.pokedex-section__heading {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
}

.pokedex-form-scroll {
    margin-top: 8px;
}

.pokedex-form-strip {
    align-items: stretch;
}

.pokedex-form-action {
    min-width: 150px;
    min-height: 50px;
    margin-right: 8px;
}

.pokedex-form-action.is-selected {
    border-color: rgb(255, 211, 92);
    background-color: rgb(190, 49, 61);
}

.pokedex-related-header {
    margin-bottom: 8px;
}

.pokedex-card-controls,
.pokedex-card-filters {
    align-items: center;
    flex-wrap: wrap;
    margin-top: 8px;
}

.pokedex-scope-action {
    margin-right: 8px;
}

.pokedex-scope-action.is-selected {
    border-color: rgb(255, 211, 92);
    background-color: rgb(190, 49, 61);
}

.pokedex-manage-button {
    margin-left: auto;
}

.pokedex-card-search {
    min-width: 260px;
    margin-right: 10px;
}

.pokedex-card-sort {
    width: 240px;
}

.pokedex-card-empty-state {
    min-height: 84px;
}

.pokedex-card-grid-row {
    min-height: 176px;
    align-items: stretch;
}

.pokedex-card-tile {
    width: 50%;
    min-height: 164px;
    margin: 4px;
    padding: 10px;
    align-items: center;
}

.pokedex-card-tile.is-hidden {
    display: none;
}

.pokedex-card-tile.is-not-installed {
    opacity: 0.68;
}

.pokedex-card-tile .async-card-image {
    width: 88px;
    height: 122px;
    flex-shrink: 0;
}

.pokedex-card-row__copy {
    margin-left: 12px;
}

.pokedex-card-row__status {
    width: 130px;
    margin-left: 8px;
    -unity-text-align: middle-right;
    white-space: normal;
}

.pokedex-overlay .mobile-layout--compact .pokedex-filters,
.pokedex-overlay .mobile-layout--compact .pokedex-detail__hero {
    flex-direction: column;
    align-items: stretch;
}

.pokedex-overlay .mobile-layout--compact .pokedex-generation,
.pokedex-overlay .mobile-layout--compact .pokedex-search,
.pokedex-overlay .mobile-layout--compact .pokedex-card-search,
.pokedex-overlay .mobile-layout--compact .pokedex-card-sort {
    width: 100%;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 6px;
}

.pokedex-overlay .mobile-layout--compact .pokedex-detail__hero {
    height: 420px;
}

.pokedex-overlay .mobile-layout--compact .pokedex-artwork {
    width: 190px;
    height: 190px;
}

.pokedex-overlay .mobile-layout--compact .pokedex-detail__copy-scroll {
    margin-left: 0;
    margin-top: 10px;
}

.pokedex-overlay .mobile-layout--compact .pokedex-card-tile {
    flex-direction: column;
    align-items: stretch;
}

.pokedex-overlay .mobile-layout--compact .pokedex-card-tile .async-card-image {
    align-self: center;
}

.pokedex-overlay .mobile-layout--compact .pokedex-card-row__copy {
    margin-left: 0;
    margin-top: 8px;
}

.pokedex-overlay .mobile-layout--compact .pokedex-card-row__status {
    width: auto;
    margin-left: 0;
    margin-top: 6px;
    -unity-text-align: middle-center;
}

.is-hidden {
    display: none;
}

.reduce-motion .pokedex-action,
.reduce-motion .pokedex-species-tile,
.reduce-motion .pokedex-form-row,
.reduce-motion .pokedex-card-tile {
    transition-duration: 0s;
}
