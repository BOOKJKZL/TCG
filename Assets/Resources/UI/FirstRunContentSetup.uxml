<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="FirstRunContentSetup.uss" />
    <ui:VisualElement name="first-run-content" class="first-run-content safe-area-root">
        <ui:VisualElement class="first-run-content__scrim" />
        <ui:ScrollView name="setup-scroll" class="first-run-content__panel" mode="Vertical">
            <ui:Label name="setup-kicker" class="first-run-content__kicker" />
            <ui:Label name="setup-title" class="first-run-content__title" />
            <ui:Label name="setup-body" class="first-run-content__body" />
            <ui:Label name="setup-language-label" class="first-run-content__label" />
            <ui:VisualElement class="first-run-content__languages">
                <ui:VisualElement name="setup-language-en" class="first-run-content__button"><ui:Label text="English" class="first-run-content__button-label" /></ui:VisualElement>
                <ui:VisualElement name="setup-language-zh" class="first-run-content__button"><ui:Label text="简体中文" class="first-run-content__button-label" /></ui:VisualElement>
                <ui:VisualElement name="setup-language-ja" class="first-run-content__button"><ui:Label text="日本語" class="first-run-content__button-label" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="setup-content-language-label" class="first-run-content__label" />
            <ui:Label name="setup-content-language-detail" class="first-run-content__detail first-run-content__detail--compact" />
            <ui:VisualElement class="first-run-content__languages">
                <ui:VisualElement name="setup-content-language-en" class="first-run-content__button"><ui:Label text="English" class="first-run-content__button-label" /></ui:VisualElement>
                <ui:VisualElement name="setup-content-language-zh" class="first-run-content__button"><ui:Label text="简体中文" class="first-run-content__button-label" /></ui:VisualElement>
                <ui:VisualElement name="setup-content-language-ja" class="first-run-content__button"><ui:Label text="日本語" class="first-run-content__button-label" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="setup-storage" class="first-run-content__detail" />
            <ui:Label name="setup-catalog" class="first-run-content__detail" />
            <ui:VisualElement name="setup-recommendation" class="first-run-content__recommendation">
                <ui:Label name="setup-recommendation-label" class="first-run-content__kicker" />
                <ui:Label name="setup-recommendation-name" class="first-run-content__recommendation-name" />
                <ui:Label name="setup-recommendation-detail" class="first-run-content__detail first-run-content__detail--compact" />
                <ui:VisualElement name="setup-recommended" class="first-run-content__button first-run-content__button--primary"><ui:Label class="first-run-content__button-label" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="first-run-content__actions">
                <ui:VisualElement name="setup-manage" class="first-run-content__button first-run-content__button--primary"><ui:Label class="first-run-content__button-label" /></ui:VisualElement>
                <ui:VisualElement name="setup-retry" class="first-run-content__button"><ui:Label class="first-run-content__button-label" /></ui:VisualElement>
                <ui:VisualElement name="setup-later" class="first-run-content__button first-run-content__button--quiet"><ui:Label class="first-run-content__button-label" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
