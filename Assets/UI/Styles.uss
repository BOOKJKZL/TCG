@import url("../Resources/UI/CoreNeutralTokens.uss");

.main-menu {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px;
}

/* Legacy decorative slots stay inert when a static template is previewed. */
.trainer-device-rail,
.trainer-status-lights {
    display: none;
}

.content-management {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 30px;
    color: var(--ui-text);
    background-color: var(--ui-canvas);
}

.content-management__shell {
    flex-grow: 1;
    width: 100%;
    max-width: 1080px;
    align-self: center;
    padding: 26px;
    border-width: 1px;
    border-radius: 18px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
}

.content-management__header,
.content-management__header-actions,
.content-package-row,
.content-package-row__actions {
    flex-direction: row;
    align-items: center;
}

.content-management__heading,
.content-package-row__copy {
    flex-grow: 1;
}

.content-package-row__copy {
    min-width: 0;
}

.content-management__title {
    color: var(--ui-text);
    font-size: 34px;
    -unity-font-style: bold;
    white-space: normal;
}

.content-management__subtitle,
.content-package-row__metadata {
    color: var(--ui-text-secondary);
    font-size: 16px;
    white-space: normal;
}

.content-management__header-actions .content-button {
    margin-left: 10px;
}

.content-management__catalog-status {
    margin-top: 14px;
    padding: 10px 14px;
    border-radius: 12px;
    color: var(--ui-primary);
    background-color: var(--ui-primary-soft);
}

.content-management__catalog-status.is-error {
    color: var(--ui-error);
    background-color: var(--ui-error-surface);
}

.content-management__catalog-status.is-warning {
    color: var(--ui-warning);
    background-color: var(--ui-warning-surface);
}

.content-management__empty {
    flex-grow: 1;
    margin-top: 16px;
    padding: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    color: var(--ui-text-secondary);
    background-color: var(--ui-raised);
    font-size: 19px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.content-management__list {
    flex-grow: 1;
    margin-top: 14px;
}

.content-management__filters {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 12px;
    padding: 10px 12px;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
}

.content-management__search {
    flex-grow: 1;
    min-width: 220px;
    margin-right: 8px;
}

.content-management__filter {
    width: 190px;
    margin-left: 8px;
}

.content-management__filters .unity-base-field__label {
    color: var(--ui-text-secondary);
    min-width: 72px;
}

.content-management__filters .unity-base-field__input {
    min-height: 42px;
    border-radius: 10px;
    color: var(--ui-text);
    background-color: var(--ui-raised);
}

.content-management__selection {
    margin-top: 10px;
    padding: 10px 12px;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--ui-outline);
    background-color: var(--ui-primary-soft);
}

.content-management__selection-summary {
    color: var(--ui-text);
    white-space: normal;
}

.content-management__wifi-only {
    margin-top: 8px;
    color: var(--ui-text);
}

.content-management__wifi-only .unity-toggle__input {
    margin-right: 8px;
}

.content-management__selection-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.content-management__selection-actions .content-button {
    min-width: 112px;
    height: auto;
    margin-left: 0;
    margin-right: 7px;
    margin-top: 4px;
    min-height: 50px;
}

.content-package-row__selection {
    width: 34px;
    min-width: 34px;
    margin-right: 10px;
}

.zero-content-panel {
    align-items: center;
    margin: 20px 0;
    padding: 24px;
    border-width: 1px;
    border-radius: 18px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
}

.zero-content-panel__text {
    margin-bottom: 14px;
    color: var(--ui-text-secondary);
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.zero-content-action {
    min-height: 50px;
    align-self: center;
}

.player-error-panel {
    margin-top: 14px;
    margin-bottom: 14px;
    padding: 20px;
    border-width: 2px;
    border-radius: 16px;
    border-color: var(--ui-error);
    background-color: var(--ui-error-surface);
    white-space: normal;
}

.player-error-panel__title {
    color: var(--ui-error);
    font-size: 23px;
    -unity-font-style: bold;
    white-space: normal;
}

.player-error-panel__body {
    margin-top: 8px;
    color: var(--ui-error);
    font-size: 18px;
    white-space: normal;
}

.player-error-panel__actions {
    margin-top: 14px;
    flex-direction: row;
    flex-wrap: wrap;
}

.content-package-row__selection .unity-toggle__label {
    display: none;
}

.content-package-row {
    height: auto;
    min-height: 148px;
    margin: 6px 4px;
    padding: 18px;
    border-width: 1px;
    border-radius: 18px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
}

.content-package-row__name {
    color: var(--ui-text);
    font-size: 23px;
    -unity-font-style: bold;
    white-space: normal;
}

.content-package-row__metadata {
    margin-top: 5px;
}

.content-package-row__status {
    margin-top: 10px;
    color: var(--ui-text-secondary);
    white-space: normal;
}

.content-package-row__status.is-error {
    color: var(--ui-error);
}

.content-package-row__status.is-success {
    color: var(--ui-success);
    -unity-font-style: bold;
}

.content-package-row__controls {
    width: 500px;
    min-width: 500px;
    flex-shrink: 0;
    margin-left: 18px;
}

.content-package-row__progress {
    height: 28px;
    margin-bottom: 12px;
}

.content-package-row__progress .unity-progress-bar__background {
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
}

.content-package-row__progress .unity-progress-bar__progress {
    background-color: var(--ui-primary);
    border-radius: 5px;
}

/* An opaque title surface preserves contrast over both filled and unfilled progress. */
.content-package-row__progress .unity-progress-bar__title {
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 4px;
    background-color: var(--ui-surface);
    color: var(--ui-text);
}

.content-package-row__actions {
    position: relative;
    height: 50px;
    overflow: hidden;
}

.content-package-row__actions .content-button {
    min-width: 102px;
    position: absolute;
    top: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.content-package-row__actions .content-package-row__download-action {
    left: 368px;
    min-width: 132px;
    width: 132px;
    max-width: 132px;
    padding-left: 8px;
    padding-right: 8px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.content-package-row__actions .content-package-row__cancel-action {
    left: 0;
    min-width: 112px;
    width: 112px;
    max-width: 112px;
}

.content-package-row__actions .content-package-row__remove-action {
    left: 120px;
    min-width: 120px;
    width: 120px;
    max-width: 120px;
}

.content-package-row__actions .content-package-row__pause-action {
    left: 248px;
    min-width: 112px;
    width: 112px;
    max-width: 112px;
}

.content-button {
    align-items: center;
    justify-content: center;
    min-width: 128px;
    height: auto;
    min-height: 50px;
    margin-left: 8px;
    padding-left: 16px;
    padding-right: 16px;
    border-width: 1px;
    border-radius: 13px;
    border-color: var(--ui-outline);
    color: var(--ui-text);
    background-color: var(--ui-raised);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
}

.content-button__label {
    color: var(--ui-text);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
    flex-shrink: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
}

.content-button:hover .content-button__label {
    color: var(--ui-primary);
}

.content-button__label.is-pressed {
    color: var(--ui-primary);
}

.content-button__label.is-disabled {
    color: var(--ui-text-secondary);
    -unity-font-style: normal;
}

.content-button:focus .content-button__label {
    color: var(--ui-primary);
    border-bottom-color: var(--ui-primary);
}

.content-button:focus .content-button__label.is-disabled {
    color: var(--ui-text-secondary);
    -unity-font-style: normal;
    border-bottom-color: transparent;
}

.content-button:hover .content-button__label.is-disabled {
    color: var(--ui-text-secondary);
}

.content-button--primary {
    background-color: var(--ui-primary);
    border-color: var(--ui-primary);
    color: var(--ui-on-primary);
}

.content-button--quiet {
    background-color: var(--ui-raised);
}

.content-button--danger {
    border-color: var(--ui-error);
    background-color: var(--ui-error);
    color: var(--ui-on-primary);
}

.content-button--primary .content-button__label {
    color: var(--ui-on-primary);
}

.content-button--primary .content-button__label.is-pressed,
.content-button--primary:focus .content-button__label.is-pressed,
.content-button--primary:hover .content-button__label,
.content-button--primary .content-button__label.is-disabled,
.content-button--primary:hover .content-button__label.is-disabled {
    color: var(--ui-primary-soft);
}

.content-button--primary:focus .content-button__label {
    color: var(--ui-on-primary);
    border-bottom-color: var(--ui-on-primary);
}

.content-button--primary:focus .content-button__label.is-disabled {
    color: var(--ui-primary-soft);
    border-bottom-color: transparent;
}

.content-button--danger .content-button__label {
    color: var(--ui-on-primary);
}

.content-button--danger .content-button__label.is-pressed,
.content-button--danger:focus .content-button__label.is-pressed,
.content-button--danger:hover .content-button__label,
.content-button--danger .content-button__label.is-disabled,
.content-button--danger:hover .content-button__label.is-disabled {
    color: var(--ui-error-surface);
}

.content-button--danger:focus .content-button__label {
    color: var(--ui-on-primary);
    border-bottom-color: var(--ui-on-primary);
}

.content-button--danger:focus .content-button__label.is-disabled {
    color: var(--ui-error-surface);
    border-bottom-color: transparent;
}

.gacha-opening {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 36px;
    color: var(--ui-text);
    background-color: var(--ui-canvas);
}

.gacha-opening__shell {
    flex-grow: 1;
    width: 100%;
    max-width: 1080px;
    align-self: center;
    padding: 28px;
    border-width: 1px;
    border-radius: 18px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
}

.gacha-opening__header,
.gacha-product-row,
.gacha-selected-product,
.gacha-odds-row,
.gacha-summary-row,
.gacha-summary__actions,
.gacha-batch-actions {
    flex-direction: row;
    align-items: center;
}

.gacha-opening__heading,
.gacha-product-row__copy,
.gacha-selected-product__body,
.gacha-summary-row__copy {
    flex-grow: 1;
}

.gacha-opening__title,
.gacha-stage__title {
    color: var(--ui-text);
    font-size: 34px;
    -unity-font-style: bold;
    white-space: normal;
}

.gacha-opening__subtitle,
.gacha-selected-product__metadata,
.gacha-product-row__metadata,
.gacha-stage__hint,
.gacha-reveal-progress,
.gacha-reveal-card__metadata,
.gacha-summary-row__metadata {
    color: var(--ui-text-secondary);
    font-size: 16px;
    white-space: normal;
}

.gacha-opening__status {
    margin-top: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    color: var(--ui-primary);
    background-color: var(--ui-primary-soft);
}

.gacha-opening__status.is-error {
    color: var(--ui-error);
    background-color: var(--ui-error-surface);
}

.gacha-page {
    flex-grow: 1;
    margin-top: 16px;
}

.gacha-selection {
    flex-direction: row;
    min-height: 0;
}

.gacha-product-list {
    width: 46%;
    flex-shrink: 0;
    margin-right: 18px;
    min-height: 240px;
}

.gacha-product-row {
    height: auto;
    margin: 5px 7px;
    padding: 10px 14px;
    border-width: 1px;
    border-radius: 16px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
    min-height: 118px;
}

.gacha-product-row__cover .async-card-image {
    width: 72px;
    height: 98px;
}

.gacha-product-row__copy {
    margin-left: 14px;
}

.gacha-product-row__name,
.gacha-selected-product__name,
.gacha-reveal-card__name,
.gacha-summary-row__name {
    color: var(--ui-text);
    font-size: 21px;
    -unity-font-style: bold;
    white-space: normal;
}

.gacha-selected-product {
    flex-grow: 0;
    padding: 22px;
    border-width: 1px;
    border-radius: 18px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
    align-items: flex-start;
}

.gacha-selected-product__art {
    width: 210px;
    align-items: center;
    justify-content: center;
}

.gacha-selected-product__art .async-card-image {
    width: 180px;
    height: 250px;
}

.gacha-selected-product__body {
    align-self: stretch;
    margin-left: 22px;
    min-width: 0;
}

.gacha-rule-badge,
.gacha-reveal-card__badge,
.gacha-summary-row__badge {
    align-self: flex-start;
    margin-top: 12px;
    padding: 5px 10px;
    border-radius: 9px;
    color: var(--ui-text-secondary);
    background-color: var(--ui-raised);
    -unity-font-style: bold;
}

.gacha-rule-badge {
    color: var(--ui-warning);
    background-color: var(--ui-warning-surface);
}

.gacha-rule-badge.is-verified {
    color: var(--ui-success);
    background-color: var(--ui-success-surface);
}

.gacha-rule-badge.is-sourced {
    color: var(--ui-primary);
    background-color: var(--ui-primary-soft);
}

.gacha-rule-notice {
    margin-top: 10px;
    color: var(--ui-warning);
    white-space: normal;
}

.gacha-rule-evidence {
    margin-top: 7px;
    color: var(--ui-text-secondary);
    font-size: 14px;
    white-space: normal;
}

.gacha-source-list {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 2px;
}

.gacha-source-button {
    align-self: flex-start;
    min-height: 50px;
    height: auto;
    margin-top: 8px;
    margin-right: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 1px;
    border-radius: 10px;
    border-color: var(--ui-outline);
    color: var(--ui-text);
    background-color: var(--ui-raised);
}

.gacha-odds-heading {
    margin-top: 18px;
    margin-bottom: 6px;
    color: var(--ui-text);
    -unity-font-style: bold;
}

.gacha-odds-scroll {
    flex-grow: 1;
    max-height: 260px;
    margin-bottom: 16px;
}

.gacha-batch-actions {
    justify-content: flex-start;
}

.gacha-batch-actions .gacha-button {
    flex-grow: 1;
    min-width: 0;
    margin-right: 8px;
}

.gacha-opening-statistics {
    margin-top: 12px;
    color: var(--ui-text-secondary);
    font-size: 13px;
    white-space: normal;
}

.gacha-opening-history {
    max-height: none;
    margin-top: 6px;
    padding: 6px 8px;
    border-width: 1px;
    border-radius: 10px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
}

.gacha-history-row {
    min-height: 24px;
    padding-top: 3px;
    padding-bottom: 3px;
    color: var(--ui-text-secondary);
    font-size: 12px;
    white-space: normal;
}

.gacha-odds-row {
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ui-outline);
}

.gacha-odds-row__name {
    flex-grow: 1;
    color: var(--ui-text);
}

.gacha-odds-row__value {
    color: var(--ui-warning);
    -unity-font-style: bold;
}

.gacha-button {
    min-width: 140px;
    min-height: 52px;
    height: auto;
    padding-left: 18px;
    padding-right: 18px;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--ui-outline);
    color: var(--ui-text);
    background-color: var(--ui-raised);
    font-size: 18px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
    white-space: normal;
}

.gacha-button--primary {
    background-color: var(--ui-primary);
    border-color: var(--ui-primary);
    color: var(--ui-on-primary);
}

.gacha-button--quiet {
    align-self: flex-start;
    background-color: var(--ui-raised);
}

.gacha-stage {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.gacha-theme-particles {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.gacha-theme-particles--reveal {
    left: 8%;
    right: 8%;
    top: 4%;
    bottom: 4%;
}

.theme-particle {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(224, 159, 255);
}

.theme-particle--diamond {
    width: 9px;
    height: 9px;
    border-radius: 1px;
    rotate: 45deg;
}

.theme-particle--dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
}

.theme-particle--shard {
    width: 4px;
    height: 14px;
    border-radius: 2px;
    rotate: -18deg;
    background-color: rgb(112, 224, 255);
}

.gacha-pack-shell {
    flex-shrink: 0;
    width: 720px;
    height: 520px;
    margin-top: 20px;
    margin-bottom: 22px;
    padding: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-width: 3px;
    border-radius: 24px;
    border-color: rgb(219, 127, 255);
    background-color: rgb(79, 37, 108);
}

.gacha-pack-stage {
    align-items: stretch;
    justify-content: flex-start;
}

.gacha-pack-stage > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    align-items: center;
    justify-content: flex-start;
}

.gacha-pack-stage > .unity-scroll-view__vertical-scroller {
    width: 12px;
}

.gacha-interactive-pack-host,
.interactive-pack-carousel {
    width: 100%;
    height: 100%;
    align-items: stretch;
    justify-content: center;
}

.interactive-pack-carousel__rail {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.interactive-pack-carousel__slot {
    flex-shrink: 0;
    width: 68px;
    height: 240px;
    opacity: 0.42;
    align-items: stretch;
    justify-content: center;
}

.interactive-pack-carousel__slot--near-left,
.interactive-pack-carousel__slot--near-right {
    width: 100px;
    height: 320px;
    opacity: 0.70;
}

.interactive-pack-carousel__slot--selected {
    width: 310px;
    height: 460px;
    opacity: 1;
}

.interactive-pack-carousel__slot-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgba(255, 255, 255, 0);
    background-color: rgba(255, 255, 255, 0);
    opacity: 1;
}

.interactive-pack-carousel__slot-label.is-pressed {
    background-color: rgba(255, 225, 126, 0.18);
}

.interactive-pack-carousel__slot-label.is-disabled {
    background-color: rgba(7, 10, 19, 0.32);
}

.interactive-pack {
    width: 100%;
    height: 100%;
    overflow: visible;
}

.interactive-pack__focus-ring {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 4px;
    bottom: 4px;
    border-width: 2px;
    border-radius: 18px;
    border-color: rgba(255, 225, 126, 0);
    background-color: rgba(0, 0, 0, 0);
}

.interactive-pack__focus-ring.is-focused,
.interactive-pack-carousel__slot:focus .interactive-pack__focus-ring {
    border-color: rgba(255, 225, 126, 0.92);
}

.interactive-pack__focus-ring.is-disabled {
    background-color: rgba(7, 10, 19, 0.28);
}

.interactive-pack-carousel__position {
    flex-shrink: 0;
    min-height: 30px;
    margin-bottom: 8px;
    color: var(--ui-on-primary);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.gacha-reveal-card {
    width: 330px;
    height: 470px;
    margin-top: 16px;
    margin-bottom: 16px;
    align-items: center;
    justify-content: center;
}

.gacha-reveal-aura {
    position: absolute;
    width: 324px;
    height: 324px;
    border-width: 4px;
    border-radius: 162px;
    border-color: rgba(255, 226, 136, 0.72);
    background-color: rgba(255, 207, 91, 0.20);
    opacity: 0;
}

.gacha-reveal-aura.is-highlighted {
    opacity: 0.42;
}

.gacha-reveal-card__art .async-card-image {
    width: 300px;
    height: 420px;
}

.gacha-reveal-card__badge {
    position: absolute;
    right: 0;
    top: 4px;
    margin-top: 0;
    color: var(--ui-text-secondary);
    background-color: var(--ui-raised);
}

.gacha-reveal-card__badge.is-new,
.gacha-summary-row__badge.is-new {
    color: var(--ui-success);
    background-color: var(--ui-success-surface);
}

.gacha-reveal-card__metadata {
    margin-top: 6px;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.gacha-reveal__actions {
    flex-direction: row;
    justify-content: center;
}

.gacha-reveal__actions .gacha-button {
    align-self: center;
    margin-left: 8px;
    margin-right: 8px;
}

.gacha-summary {
    align-items: stretch;
    justify-content: flex-start;
}

.gacha-summary-list {
    flex-grow: 1;
    margin-top: 18px;
    margin-bottom: 18px;
}

.gacha-summary-row {
    min-height: 70px;
    margin-bottom: 8px;
    padding: 10px 14px;
    border-width: 1px;
    border-radius: 13px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
}

.gacha-summary-row__badge {
    align-self: center;
    margin-top: 0;
    margin-left: 12px;
}

.gacha-summary__actions {
    justify-content: center;
}

.gacha-theme--vintage .gacha-pack-shell {
    border-color: rgb(218, 170, 91);
    background-color: rgb(83, 53, 48);
}

.gacha-theme--vintage .gacha-pack-shell__theme-band,
.gacha-theme--vintage .gacha-pack-shell__tear {
    background-color: rgb(239, 205, 126);
}

.gacha-theme--vintage .gacha-reveal-aura {
    border-color: rgba(255, 222, 139, 0.78);
    background-color: rgba(210, 151, 72, 0.24);
}

.gacha-theme--vintage .theme-particle {
    background-color: rgb(244, 208, 132);
}

.gacha-theme--vintage .theme-particle--shard {
    background-color: rgb(202, 133, 76);
}

.gacha-theme--forest .gacha-pack-shell {
    border-color: rgb(135, 213, 143);
    background-color: rgb(35, 82, 61);
}

.gacha-theme--forest .gacha-pack-shell__theme-band,
.gacha-theme--forest .gacha-pack-shell__tear {
    background-color: rgb(220, 214, 103);
}

.gacha-theme--forest .gacha-reveal-aura {
    border-color: rgba(186, 247, 139, 0.78);
    background-color: rgba(87, 202, 118, 0.22);
}

.gacha-theme--forest .theme-particle {
    background-color: rgb(176, 238, 120);
}

.gacha-theme--forest .theme-particle--shard {
    background-color: rgb(246, 223, 104);
}

.gacha-theme--ruby .gacha-pack-shell {
    border-color: rgb(255, 117, 128);
    background-color: rgb(121, 34, 54);
}

.gacha-theme--ruby .gacha-pack-shell__theme-band,
.gacha-theme--ruby .gacha-pack-shell__tear {
    background-color: rgb(236, 226, 222);
}

.gacha-theme--ruby .gacha-reveal-aura {
    border-color: rgba(255, 129, 140, 0.82);
    background-color: rgba(229, 61, 88, 0.24);
}

.gacha-theme--ruby .theme-particle {
    background-color: rgb(255, 113, 128);
}

.gacha-theme--ruby .theme-particle--shard {
    background-color: rgb(255, 192, 105);
}

.gacha-theme--electric .gacha-pack-shell {
    border-color: rgb(83, 207, 255);
    background-color: rgb(38, 64, 142);
}

.gacha-theme--electric .gacha-pack-shell__theme-band,
.gacha-theme--electric .gacha-pack-shell__tear {
    background-color: rgb(255, 92, 184);
}

.gacha-theme--electric .gacha-reveal-aura {
    border-color: rgba(101, 220, 255, 0.86);
    background-color: rgba(80, 137, 255, 0.26);
}

.gacha-theme--electric .theme-particle {
    background-color: rgb(83, 221, 255);
}

.gacha-theme--electric .theme-particle--shard {
    background-color: rgb(255, 92, 184);
}

.gacha-theme--gallery .gacha-pack-shell {
    border-color: rgb(220, 129, 255);
    background-color: rgb(92, 42, 120);
}

.gacha-theme--gallery .gacha-pack-shell__theme-band {
    background-color: rgb(255, 102, 91);
}

.gacha-theme--gallery .gacha-pack-shell__tear {
    background-color: rgb(111, 224, 255);
}

.gacha-theme--gallery .gacha-reveal-aura {
    border-color: rgba(239, 145, 255, 0.88);
    background-color: rgba(255, 88, 157, 0.25);
}

.gacha-theme--gallery .theme-particle {
    background-color: rgb(230, 137, 255);
}

.gacha-theme--gallery .theme-particle--shard {
    background-color: rgb(255, 107, 113);
}

.reduce-motion .gacha-button,
.reduce-motion .gacha-product-row {
    transition-duration: 0s;
}

.reduce-motion .gacha-theme-particles {
    display: none;
}

.gacha-summary__actions .gacha-button {
    margin-left: 8px;
    margin-right: 8px;
}

.collection-browser {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 36px;
    color: var(--ui-text);
    background-color: var(--ui-canvas);
}

.collection-browser__shell {
    flex-grow: 1;
    max-width: 1040px;
    align-self: center;
    width: 100%;
    padding: 28px;
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
}

.collection-browser__header,
.card-page__header,
.set-row,
.card-row {
    flex-direction: row;
    align-items: center;
}

.collection-browser__heading,
.card-page__heading,
.browser-row__copy {
    flex-grow: 1;
}

.collection-browser__actions {
    flex-direction: row;
    align-items: center;
}

.browser-button--pokedex {
    margin-right: 10px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
    color: var(--ui-text);
}

.collection-browser__title,
.card-page__title {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--ui-text);
    white-space: normal;
}

.collection-browser__subtitle,
.collection-browser__status,
.card-page__count,
.browser-row__metadata,
.details-panel__metadata {
    color: var(--ui-text-secondary);
    font-size: 17px;
    white-space: normal;
}

.collection-browser__status {
    margin-top: 12px;
    margin-bottom: 14px;
    flex-shrink: 0;
    margin: 0 0 10px 0;
    color: var(--ui-text-secondary);
    font-size: 17px;
    white-space: normal;
}

.collection-browser__status.is-error {
    color: var(--ui-error);
}

.browser-page,
.browser-list {
    flex-grow: 1;
}

.card-page__header {
    margin-bottom: 10px;
    flex-shrink: 0;
}

.card-page__heading {
    margin-left: 18px;
}

.browser-button {
    min-width: 140px;
    min-height: 52px;
    height: auto;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
    color: var(--ui-text);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.browser-button--quiet {
    background-color: var(--ui-raised);
}

.browser-button--filter {
    min-width: 132px;
    height: 44px;
    margin-left: 8px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 15px;
}

.browser-button--filter.is-selected {
    border-color: var(--ui-primary);
    background-color: var(--ui-raised);
    color: var(--ui-primary);
}

.collection-filters {
    margin-bottom: 10px;
    padding: 12px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
    flex-shrink: 0;
}

.collection-filter {
    color: var(--ui-text-secondary);
    font-size: 14px;
    white-space: normal;
}

.collection-filter--search {
    width: 250px;
    margin-right: 10px;
}

.collection-filter--rarity {
    width: 210px;
}

.collection-filter__toggles {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
}

.collection-filter .unity-base-text-field__input,
.collection-filter .unity-base-popup-field__input {
    min-height: 48px;
    border-radius: 9px;
    border-width: 1px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
    color: var(--ui-text);
}

.collection-filter__empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 28px;
    border-radius: 16px;
    background-color: var(--ui-raised);
    color: var(--ui-text-secondary);
    font-size: 19px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.set-row,
.card-row {
    height: 100%;
    margin: 5px 8px;
    padding: 10px 16px;
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
}

.card-row.is-unowned {
    background-color: var(--ui-raised);
}

.card-row.is-new {
    border-color: var(--ui-success);
    background-color: var(--ui-success-surface);
}

.browser-row__copy {
    margin-left: 18px;
}

.browser-row__title,
.details-panel__name {
    color: var(--ui-text);
    font-size: 23px;
    -unity-font-style: bold;
    white-space: normal;
}

.card-row__rarity {
    margin-top: 8px;
    color: var(--ui-warning);
    font-size: 17px;
    white-space: normal;
}

.card-row__progress {
    min-width: 112px;
    margin-left: 12px;
    align-items: flex-end;
}

.card-row__owned,
.details-panel__progress {
    color: var(--ui-text-secondary);
    font-size: 15px;
    white-space: normal;
}

.card-row__owned.is-owned,
.details-panel__progress {
    color: var(--ui-success);
}

.card-row__new,
.details-panel__new {
    margin-bottom: 8px;
    padding: 4px 9px;
    border-radius: 9px;
    background-color: var(--ui-success-surface);
    color: var(--ui-success);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.async-card-image {
    position: relative;
    width: 82px;
    height: 110px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 10px;
    background-color: var(--ui-raised);
}

.async-card-image__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.async-card-image__status {
    position: absolute;
    left: 5px;
    right: 5px;
    top: 34px;
    color: var(--ui-text-secondary);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.async-card-image__retry {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 6px;
    height: 48px;
    border-radius: 7px;
    background-color: var(--ui-error-surface);
    color: var(--ui-error);
    font-size: 11px;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    transition-property: none;
    white-space: normal;
}

.details-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.details-panel__scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--ui-scrim);
}

.details-panel__card {
    width: 520px;
    max-width: 88%;
    padding: 28px;
    align-items: center;
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
}

.details-panel__art .async-card-image {
    width: 280px;
    height: 390px;
}

.details-panel__name {
    margin-top: 18px;
    -unity-text-align: middle-center;
}

.details-panel__languages {
    margin-top: 14px;
    padding: 4px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
}

.details-panel__language {
    min-width: 58px;
    height: 38px;
    margin-left: 3px;
    margin-right: 3px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
    color: var(--ui-text);
    font-size: 15px;
    -unity-font-style: bold;
    transition-property: background-color, border-color, color;
    transition-duration: 0.1s;
    white-space: normal;
}

.details-panel__language.is-selected {
    border-color: var(--ui-primary);
    background-color: var(--ui-primary-soft);
    color: var(--ui-primary);
}

.reduce-motion .details-panel__language {
    transition-duration: 0s;
}

.details-panel__metadata {
    margin-top: 8px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.details-panel__progress {
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.details-panel__new {
    margin-top: 14px;
    margin-bottom: 0;
}

/* Safe Area is added as inline padding on the full-screen background roots.
   Compact rules keep controls reachable after asymmetric display insets. */
.content-management .mobile-layout--compact .content-management__shell,
.gacha-opening.mobile-layout--compact .gacha-opening__shell,
.collection-browser.mobile-layout--compact .collection-browser__shell {
    padding: 18px;
}

.content-management .mobile-layout--compact .content-management__header,
.content-management .mobile-layout--compact .content-management__header-actions,
.gacha-opening.mobile-layout--compact .gacha-opening__header,
.collection-browser.mobile-layout--compact .collection-browser__header,
.collection-browser.mobile-layout--compact .card-page__header,
.collection-browser.mobile-layout--compact .collection-browser__actions {
    flex-wrap: wrap;
}

.content-management .mobile-layout--compact .content-management__filters {
    flex-direction: column;
    align-items: stretch;
}

.content-management .mobile-layout--compact .content-management__search,
.content-management .mobile-layout--compact .content-management__filter {
    width: 100%;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 6px;
}

/* Mobile pack-opening presentation. The shared page shell owns the only Safe Area
   binding; this host remains edge-to-edge and contains no durable inline state. */
.gacha-opening-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--ui-canvas);
}

.gacha-opening-host > .gacha-opening {
    padding: 0;
}

.gacha-opening-host .is-hidden {
    display: none;
}

.gacha-opening__body {
    flex-grow: 1;
    min-height: 0;
    padding: 0 12px 12px 12px;
}

.gacha-opening .gacha-page,
.gacha-opening .gacha-stage,
.gacha-opening .gacha-summary-list {
    min-height: 0;
}

.gacha-opening .gacha-summary-list {
    overflow: hidden;
}

.gacha-opening .gacha-summary__actions {
    flex-shrink: 0;
}

.gacha-opening .mobile-sheet__panel {
    width: auto;
    max-width: 760px;
    align-self: stretch;
    margin-left: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
}

.gacha-opening .mobile-sheet__safe-area.mobile-layout--compact .mobile-sheet__panel {
    max-width: 640px;
}

.gacha-selected-product-scroll {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.gacha-source-button__label,
.gacha-button__label {
    color: var(--ui-text);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
    width: 100%;
    flex-shrink: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
}

.gacha-source-button__label {
    color: var(--ui-text);
    font-size: 15px;
    white-space: normal;
}

.gacha-button__label.is-pressed,
.gacha-source-button__label.is-pressed {
    color: var(--ui-primary);
}

.gacha-button__label.is-disabled,
.gacha-source-button__label.is-disabled,
.gacha-button:focus .gacha-button__label.is-disabled,
.gacha-source-button:focus .gacha-source-button__label.is-disabled {
    color: var(--ui-text-secondary);
    -unity-font-style: normal;
}

.gacha-button:focus .gacha-button__label,
.gacha-source-button:focus .gacha-source-button__label {
    color: var(--ui-primary);
    border-bottom-color: var(--ui-primary);
}

.gacha-button--primary .gacha-button__label {
    color: var(--ui-on-primary);
}

.gacha-button--primary .gacha-button__label.is-pressed,
.gacha-button--primary:focus .gacha-button__label.is-pressed,
.gacha-button--primary:hover .gacha-button__label,
.gacha-button--primary .gacha-button__label.is-disabled {
    color: var(--ui-primary-soft);
}

.gacha-button--primary:focus .gacha-button__label {
    color: var(--ui-on-primary);
    border-bottom-color: var(--ui-on-primary);
}

.gacha-button--primary:focus .gacha-button__label.is-disabled {
    color: var(--ui-primary-soft);
    border-bottom-color: transparent;
}

.gacha-opening .mobile-layout--compact .gacha-selection {
    flex-direction: column;
}

.gacha-opening .mobile-layout--compact .gacha-product-list {
    width: 100%;
    height: 220px;
    margin-right: 0;
    margin-bottom: 12px;
}

.gacha-opening .mobile-layout--compact .gacha-selected-product {
    flex-direction: column;
    align-items: stretch;
    padding: 16px;
}

.gacha-opening .mobile-layout--compact .gacha-selected-product__art {
    width: 100%;
    margin-bottom: 12px;
}

.gacha-opening .mobile-layout--compact .gacha-selected-product__body {
    margin-left: 0;
}

.gacha-opening .mobile-layout--compact .gacha-batch-actions,
.gacha-opening .mobile-layout--compact .gacha-reveal__actions,
.gacha-opening .mobile-layout--compact .gacha-summary__actions,
.gacha-opening .mobile-layout--compact .player-error-panel__actions {
    flex-direction: column;
    align-items: stretch;
}

.gacha-opening .mobile-layout--compact .gacha-batch-actions .gacha-button,
.gacha-opening .mobile-layout--compact .gacha-reveal__actions .gacha-button,
.gacha-opening .mobile-layout--compact .gacha-summary__actions .gacha-button,
.gacha-opening .mobile-layout--compact .player-error-panel__actions .gacha-button {
    width: 100%;
    margin: 6px 0 0 0;
}

.gacha-opening .mobile-layout--compact .gacha-pack-shell,
.gacha-opening .mobile-layout--compact .gacha-reveal-card {
    width: 100%;
    height: 440px;
}

.gacha-opening .mobile-layout--compact .interactive-pack-carousel__slot {
    width: 52px;
    height: 190px;
}

.gacha-opening .mobile-layout--compact .interactive-pack-carousel__slot--near-left,
.gacha-opening .mobile-layout--compact .interactive-pack-carousel__slot--near-right {
    width: 70px;
    height: 250px;
}

.gacha-opening .mobile-layout--compact .interactive-pack-carousel__slot--selected {
    width: 250px;
    height: 380px;
}

.gacha-opening .mobile-layout--compact .gacha-reveal-card__art .async-card-image {
    width: 260px;
    height: 364px;
}

.content-management .mobile-layout--compact .content-package-row {
    height: auto;
    min-height: 236px;
    flex-direction: column;
    align-items: stretch;
}

.content-management .mobile-layout--compact .content-package-row__controls {
    width: 100%;
    min-width: 0;
    margin-left: 0;
    margin-top: 12px;
}

.content-management .mobile-layout--compact .content-package-row__actions {
    height: auto;
    min-height: 104px;
    flex-wrap: wrap;
    overflow: visible;
}

.content-management .mobile-layout--compact .content-package-row__actions .content-button {
    position: relative;
    left: auto;
    width: auto;
    min-width: 112px;
    max-width: 100%;
    flex-grow: 1;
    margin-right: 6px;
    margin-bottom: 6px;
}

.content-management__launch {
    display: none;
    margin-top: 10px;
    padding: 16px;
    border-width: 2px;
    border-radius: 18px;
    border-color: var(--ui-outline);
    background-color: var(--ui-primary-soft);
}

.content-management__launch-title {
    color: var(--ui-text);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.content-management__launch-body {
    margin-top: 6px;
    color: var(--ui-text);
    font-size: 17px;
    white-space: normal;
}

.content-management__launch .content-button {
    align-self: flex-start;
    min-height: 50px;
    margin-top: 10px;
}

.content-management__bottom-navigation {
    flex-shrink: 0;
    margin-top: 10px;
}

.content-management .mobile-layout--compact .content-management__launch .content-button {
    align-self: stretch;
    width: 100%;
}
.content-management-host {
    flex-grow: 1;
}

/* Mobile collection presentation. The shared page shell owns the page Safe Area;
   the full-screen detail sheet owns its modal Safe Area. */
.collection-browser-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--ui-canvas);
}

.collection-browser-host > .collection-browser {
    padding: 0;
}

.collection-browser-host .is-hidden {
    display: none;
}

.collection-browser__body,
.browser-page,
.browser-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.collection-browser__body.is-pending {
    background-color: var(--ui-raised);
}

.collection-action {
    min-width: 132px;
    min-height: 52px;
    height: auto;
    padding: 10px 16px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
    transition-property: none;
}

.collection-action--primary {
    border-color: var(--ui-primary);
    background-color: var(--ui-primary);
}

.collection-action--quiet {
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
}

.collection-action--filter {
    min-width: 128px;
    margin-left: 8px;
}

.collection-action__label {
    color: var(--ui-text);
    font-size: 17px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
    width: 100%;
    flex-shrink: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
}

.collection-action__label.is-pressed,
.set-row .browser-row__title.is-pressed,
.card-tile .card-tile__name.is-pressed,
.async-card-image__retry-label.is-pressed {
    color: var(--ui-primary);
}

.collection-action__label.is-disabled,
.collection-action:focus .collection-action__label.is-disabled,
.set-row .browser-row__title.is-disabled,
.set-row:focus .browser-row__title.is-disabled,
.card-tile .card-tile__name.is-disabled,
.card-tile:focus .card-tile__name.is-disabled,
.async-card-image__retry-label.is-disabled {
    color: var(--ui-text-secondary);
    -unity-font-style: normal;
}

.collection-action:focus .collection-action__label,
.set-row:focus .browser-row__title,
.card-tile:focus .card-tile__name {
    color: var(--ui-primary);
    border-bottom-color: var(--ui-primary);
}

.collection-action.is-selected {
    border-color: var(--ui-primary);
    background-color: var(--ui-raised);
}

.collection-action.is-selected .collection-action__label {
    color: var(--ui-primary);
    border-bottom-color: var(--ui-primary);
}

.collection-action--primary .collection-action__label {
    color: var(--ui-on-primary);
}

.collection-action--primary .collection-action__label.is-pressed,
.collection-action--primary:focus .collection-action__label.is-pressed,
.collection-action--primary:hover .collection-action__label,
.collection-action--primary .collection-action__label.is-disabled {
    color: var(--ui-primary-soft);
}

.collection-action--primary:focus .collection-action__label {
    color: var(--ui-on-primary);
    border-bottom-color: var(--ui-on-primary);
}

.collection-action--primary:focus .collection-action__label.is-disabled {
    color: var(--ui-primary-soft);
    border-bottom-color: transparent;
}

.collection-filter--sort {
    width: 190px;
    margin-left: 10px;
}

.collection-filter-sheet-action {
    flex-shrink: 0;
    align-self: stretch;
    margin-bottom: 10px;
}

.collection-filter-sheet .mobile-sheet__panel {
    max-height: 90%;
}

.collection-filter-sheet .collection-filters {
    margin: 0;
    flex-direction: column;
    align-items: stretch;
}

.collection-filter-sheet .collection-filter,
.collection-filter-sheet .collection-filter--search,
.collection-filter-sheet .collection-filter--rarity,
.collection-filter-sheet .collection-filter--sort {
    width: 100%;
    min-width: 0;
    margin: 6px 0 0 0;
}

.collection-filter-sheet .collection-filter__toggles {
    flex-direction: column;
    align-items: stretch;
}

.collection-filter-sheet .collection-action--filter {
    width: 100%;
    margin: 6px 0 0 0;
}

.collection-set-list,
.collection-card-grid {
    /* The scroll viewport must fit short/landscape screens above the fixed navigation. */
    min-height: 0;
    width: 100%;
    max-width: 100%;
}

.collection-card-grid > .unity-scroll-view__content-viewport,
.collection-card-grid > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    width: 100%;
    max-width: 100%;
}

.set-row {
    height: auto;
    min-height: 132px;
    margin: 6px 8px;
    transition-property: none;
}

.card-grid-row {
    width: 100%;
    max-width: 100%;
    height: auto;
    min-height: 350px;
    flex-direction: row;
    align-items: stretch;
    margin: 4px 5px 10px 5px;
}

.card-tile {
    width: auto;
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 340px;
    margin-left: 5px;
    margin-right: 5px;
    padding: 14px;
    align-items: stretch;
    border-width: 1px;
    border-radius: 18px;
    border-color: var(--ui-outline);
    background-color: var(--ui-surface);
    transition-property: none;
}

.card-tile.is-unowned {
    background-color: var(--ui-raised);
}

.card-tile.is-new {
    border-color: var(--ui-success);
    background-color: var(--ui-success-surface);
}

.card-tile__image.async-card-image {
    width: 166px;
    height: 232px;
    align-self: center;
}

.card-tile__copy {
    flex-grow: 1;
    min-width: 0;
    margin-top: 10px;
}

.card-tile__name {
    color: var(--ui-text);
    font-size: 19px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.card-tile__number,
.card-tile__rarity,
.card-tile__owned {
    margin-top: 5px;
    color: var(--ui-text-secondary);
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.card-tile__rarity {
    color: var(--ui-warning);
}

.card-tile__progress {
    min-height: 30px;
    margin-top: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.card-tile__owned.is-owned {
    color: var(--ui-success);
}

.card-tile__new,
.collection-detail__new {
    padding: 4px 9px;
    border-radius: 9px;
    background-color: var(--ui-success-surface);
    color: var(--ui-success);
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.collection-detail-sheet .mobile-sheet__safe-area {
    justify-content: center;
}

.collection-detail-sheet .mobile-sheet__panel {
    width: 100%;
    height: 100%;
    max-width: 760px;
    max-height: 100%;
    border-radius: 18px;
}

.collection-detail-sheet .mobile-sheet__content {
    min-height: 0;
}

.collection-detail {
    flex-grow: 1;
    min-height: 0;
}

.collection-detail > .unity-scroll-view__content-container {
    align-items: center;
    padding-bottom: 12px;
}

.collection-detail__art .async-card-image {
    width: 270px;
    height: 378px;
}

.collection-detail__new {
    margin-top: 12px;
}

.collection-detail__languages {
    margin-top: 14px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
}

.collection-detail__language.mobile-action {
    min-width: 74px;
    min-height: 52px;
    width: auto;
    margin: 4px;
    border-color: var(--ui-outline);
    background-color: var(--ui-raised);
}

.collection-detail__language .mobile-action__label {
    color: var(--ui-text);
}

.collection-detail__language.is-selected {
    border-color: var(--ui-primary);
    background-color: var(--ui-raised);
}

.collection-detail__language.is-selected .mobile-action__label {
    color: var(--ui-primary);
}

.collection-detail__language .mobile-action__label.is-pressed {
    color: var(--ui-primary);
}

.collection-detail__language .mobile-action__label.is-disabled {
    color: var(--ui-text-secondary);
}

.collection-detail__name {
    margin-top: 14px;
    color: var(--ui-text);
    font-size: 25px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.collection-detail__metadata,
.collection-detail__progress {
    margin-top: 8px;
    color: var(--ui-text-secondary);
    font-size: 17px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.collection-detail__progress {
    color: var(--ui-success);
}

.async-card-image__retry-label {
    color: var(--ui-error);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.async-card-image__retry-label.is-pressed {
    color: var(--ui-text);
}

.async-card-image__retry:focus .async-card-image__retry-label {
    color: var(--ui-error);
    border-bottom-width: 2px;
    border-bottom-color: var(--ui-error);
}

.collection-browser .mobile-layout--compact .card-page__header,
.collection-browser .mobile-layout--compact .collection-filter__toggles,
.collection-browser .mobile-layout--compact .player-error-panel__actions {
    flex-direction: column;
    align-items: stretch;
}

.collection-browser .mobile-layout--compact .collection-filters {
    flex-direction: column;
    align-items: stretch;
}

.collection-browser .mobile-layout--compact .collection-filter,
.collection-browser .mobile-layout--compact .collection-filter--search,
.collection-browser .mobile-layout--compact .collection-filter--rarity,
.collection-browser .mobile-layout--compact .collection-filter--sort {
    width: 100%;
    min-width: 0;
    margin: 6px 0 0 0;
}

.collection-browser .mobile-layout--compact .collection-action--filter,
.collection-browser .mobile-layout--compact .player-error-panel__actions .collection-action {
    width: 100%;
    margin: 6px 0 0 0;
}

.collection-browser .mobile-layout--compact .card-grid-row {
    min-height: 322px;
}

.collection-browser .mobile-layout--compact .card-tile {
    min-height: 312px;
    padding: 10px;
}

.collection-browser .mobile-layout--compact .card-tile__image.async-card-image {
    width: 142px;
    height: 198px;
}

.collection-detail-sheet .mobile-sheet__safe-area.mobile-layout--compact .mobile-sheet__panel {
    max-width: 640px;
    padding: 16px;
}

.collection-detail-sheet .mobile-sheet__safe-area.mobile-layout--compact .collection-detail__art .async-card-image {
    width: 238px;
    height: 334px;
}
