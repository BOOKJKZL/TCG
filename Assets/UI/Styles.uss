.main-menu { flex-direction: column; align-items: center; justify-content: center; padding: 16px; }

.trainer-device-rail {
    height: 8px;
    flex-shrink: 0;
    flex-direction: row;
    margin-left: -28px;
    margin-right: -28px;
    margin-top: -28px;
    margin-bottom: 20px;
    overflow: hidden;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
}

.trainer-device-rail__red {
    flex-grow: 5;
    background-color: rgb(222, 53, 63);
}

.trainer-device-rail__yellow {
    flex-grow: 2;
    background-color: rgb(255, 211, 65);
}

.trainer-device-rail__blue {
    flex-grow: 3;
    background-color: rgb(52, 137, 214);
}

.trainer-status-lights {
    width: 104px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-right: 16px;
}

.trainer-status-light {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    margin-left: 5px;
    border-width: 2px;
    border-radius: 6px;
    border-color: rgba(255, 255, 255, 0.72);
}

.trainer-status-light--lens {
    width: 38px;
    height: 38px;
    margin-left: 0;
    margin-right: 4px;
    border-width: 4px;
    border-radius: 21px;
    border-color: rgb(235, 249, 255);
    background-color: rgb(66, 204, 241);
}

.trainer-status-light--red {
    background-color: rgb(240, 74, 81);
}

.trainer-status-light--yellow {
    background-color: rgb(255, 211, 65);
}

.trainer-status-light--green {
    background-color: rgb(78, 203, 128);
}

.content-management {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 30px;
    color: rgb(236, 247, 255);
    background-color: rgba(4, 12, 23, 0.96);
}

.content-management__shell {
    flex-grow: 1;
    width: 100%;
    max-width: 1080px;
    align-self: center;
    padding: 26px;
    border-width: 2px;
    border-radius: 28px;
    border-color: rgba(66, 196, 213, 0.7);
    background-color: rgba(16, 34, 49, 0.98);
}

.content-management__header,
.content-management__header-actions,
.content-package-row,
.content-package-row__actions {
    flex-direction: row;
    align-items: center;
}

.content-management__heading,
.content-package-row__copy {
    flex-grow: 1;
}

.content-package-row__copy {
    min-width: 0;
}

.content-management__title {
    color: white;
    font-size: 34px;
    -unity-font-style: bold;
}

.content-management__subtitle,
.content-package-row__metadata {
    color: rgb(159, 190, 208);
    font-size: 16px;
    white-space: normal;
}

.content-management__header-actions .content-button {
    margin-left: 10px;
}

.content-management__catalog-status {
    margin-top: 14px;
    padding: 10px 14px;
    border-radius: 12px;
    color: rgb(211, 237, 242);
    background-color: rgba(35, 84, 98, 0.92);
}

.content-management__catalog-status.is-error {
    color: rgb(255, 225, 228);
    background-color: rgba(133, 42, 55, 0.92);
}

.content-management__catalog-status.is-warning {
    color: rgb(255, 242, 201);
    background-color: rgba(126, 86, 26, 0.94);
}

.content-management__empty {
    flex-grow: 1;
    margin-top: 16px;
    padding: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    color: rgb(164, 194, 211);
    background-color: rgba(10, 25, 38, 0.88);
    font-size: 19px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.content-management__list {
    flex-grow: 1;
    margin-top: 14px;
}

.content-management__filters {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 12px;
    padding: 10px 12px;
    border-width: 1px;
    border-radius: 14px;
    border-color: rgba(88, 161, 174, 0.55);
    background-color: rgba(10, 25, 38, 0.72);
}

.content-management__search {
    flex-grow: 1;
    min-width: 220px;
    margin-right: 8px;
}

.content-management__filter {
    width: 190px;
    margin-left: 8px;
}

.content-management__filters .unity-base-field__label {
    color: rgb(177, 211, 235);
    min-width: 72px;
}

.content-management__filters .unity-base-field__input {
    min-height: 42px;
    border-radius: 10px;
    color: rgb(21, 43, 67);
    background-color: rgb(243, 247, 250);
}

.content-management__selection {
    margin-top: 10px;
    padding: 10px 12px;
    border-width: 1px;
    border-radius: 14px;
    border-color: rgba(103, 196, 241, 0.65);
    background-color: rgba(18, 50, 81, 0.9);
}

.content-management__selection-summary {
    color: rgb(220, 239, 252);
    white-space: normal;
}

.content-management__wifi-only {
    margin-top: 8px;
    color: rgb(220, 239, 252);
}

.content-management__wifi-only .unity-toggle__input {
    margin-right: 8px;
}

.content-management__selection-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.content-management__selection-actions .content-button {
    min-width: 112px;
    height: 42px;
    margin-left: 0;
    margin-right: 7px;
    margin-top: 4px;
}

.content-package-row__selection {
    width: 34px;
    min-width: 34px;
    margin-right: 10px;
}

.content-package-row__selection .unity-toggle__label {
    display: none;
}

.content-package-row {
    height: auto;
    min-height: 148px;
    margin: 6px 4px;
    padding: 18px;
    border-width: 1px;
    border-radius: 18px;
    border-color: rgba(88, 161, 174, 0.55);
    background-color: rgba(25, 51, 67, 0.96);
}

.content-package-row__name {
    color: white;
    font-size: 23px;
    -unity-font-style: bold;
}

.content-package-row__metadata {
    margin-top: 5px;
}

.content-package-row__status {
    margin-top: 10px;
    color: rgb(147, 218, 192);
    white-space: normal;
}

.content-package-row__status.is-error {
    color: rgb(255, 151, 157);
}

.content-package-row__status.is-success {
    color: rgb(126, 239, 177);
    -unity-font-style: bold;
}

.content-package-row__controls {
    width: 500px;
    min-width: 500px;
    flex-shrink: 0;
    margin-left: 18px;
}

.content-package-row__progress {
    height: 28px;
    margin-bottom: 12px;
}

.content-package-row__actions {
    position: relative;
    height: 50px;
    overflow: hidden;
}

.content-package-row__actions .content-button {
    min-width: 102px;
    position: absolute;
    top: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.content-package-row__actions .content-package-row__download-action {
    left: 368px;
    min-width: 132px;
    width: 132px;
    max-width: 132px;
    padding-left: 8px;
    padding-right: 8px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.content-package-row__actions .content-package-row__cancel-action {
    left: 0;
    min-width: 112px;
    width: 112px;
    max-width: 112px;
}

.content-package-row__actions .content-package-row__remove-action {
    left: 120px;
    min-width: 120px;
    width: 120px;
    max-width: 120px;
}

.content-package-row__actions .content-package-row__pause-action {
    left: 248px;
    min-width: 112px;
    width: 112px;
    max-width: 112px;
}

.content-button {
    align-items: center;
    justify-content: center;
    min-width: 128px;
    height: 50px;
    min-height: 50px;
    margin-left: 8px;
    padding-left: 16px;
    padding-right: 16px;
    border-width: 1px;
    border-radius: 13px;
    border-color: rgba(106, 222, 231, 0.9);
    color: white;
    background-color: rgb(24, 119, 137);
    font-size: 16px;
    -unity-font-style: bold;
}

.content-button__label {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.content-button:hover .content-button__label {
    color: rgb(211, 247, 250);
}

.content-button__label.is-pressed {
    color: rgb(132, 239, 247);
}

.content-button--primary {
    background-color: rgb(37, 137, 104);
}

.content-button--quiet {
    background-color: rgba(44, 70, 87, 0.96);
}

.content-button--danger {
    border-color: rgba(238, 121, 132, 0.9);
    background-color: rgb(137, 52, 65);
}

.gacha-opening {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 36px;
    color: rgb(240, 247, 255);
    background-color: rgba(4, 9, 20, 0.94);
}

.gacha-opening__shell {
    flex-grow: 1;
    width: 100%;
    max-width: 1080px;
    align-self: center;
    padding: 28px;
    border-width: 2px;
    border-radius: 28px;
    border-color: rgba(203, 91, 255, 0.72);
    background-color: rgba(23, 22, 48, 0.97);
}

.gacha-opening__header,
.gacha-product-row,
.gacha-selected-product,
.gacha-odds-row,
.gacha-summary-row,
.gacha-summary__actions,
.gacha-batch-actions {
    flex-direction: row;
    align-items: center;
}

.gacha-opening__heading,
.gacha-product-row__copy,
.gacha-selected-product__body,
.gacha-summary-row__copy {
    flex-grow: 1;
}

.gacha-opening__title,
.gacha-stage__title {
    color: white;
    font-size: 34px;
    -unity-font-style: bold;
}

.gacha-opening__subtitle,
.gacha-selected-product__metadata,
.gacha-product-row__metadata,
.gacha-stage__hint,
.gacha-reveal-progress,
.gacha-reveal-card__metadata,
.gacha-summary-row__metadata {
    color: rgb(174, 186, 219);
    font-size: 16px;
    white-space: normal;
}

.gacha-opening__status {
    margin-top: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    color: rgb(221, 234, 247);
    background-color: rgba(48, 78, 104, 0.88);
}

.gacha-opening__status.is-error {
    color: rgb(255, 225, 228);
    background-color: rgba(133, 42, 55, 0.92);
}

.gacha-page {
    flex-grow: 1;
    margin-top: 16px;
}

.gacha-selection {
    flex-direction: row;
}

.gacha-product-list {
    width: 46%;
    flex-shrink: 0;
    margin-right: 18px;
}

.gacha-product-row {
    height: 100%;
    margin: 5px 7px;
    padding: 10px 14px;
    border-width: 1px;
    border-radius: 16px;
    border-color: rgba(125, 109, 182, 0.55);
    background-color: rgba(42, 41, 78, 0.96);
    transition-property: scale, background-color, border-color;
    transition-duration: 0.12s;
}

.gacha-product-row:hover {
    scale: 1.01 1.01;
    border-color: rgb(215, 119, 255);
    background-color: rgb(57, 50, 100);
}

.gacha-product-row__cover .async-card-image {
    width: 72px;
    height: 98px;
}

.gacha-product-row__copy {
    margin-left: 14px;
}

.gacha-product-row__name,
.gacha-selected-product__name,
.gacha-reveal-card__name,
.gacha-summary-row__name {
    color: white;
    font-size: 21px;
    -unity-font-style: bold;
    white-space: normal;
}

.gacha-selected-product {
    flex-grow: 1;
    padding: 22px;
    border-width: 1px;
    border-radius: 22px;
    border-color: rgba(198, 119, 238, 0.66);
    background-color: rgba(38, 34, 69, 0.98);
}

.gacha-selected-product__art {
    width: 210px;
    align-items: center;
    justify-content: center;
}

.gacha-selected-product__art .async-card-image {
    width: 180px;
    height: 250px;
}

.gacha-selected-product__body {
    align-self: stretch;
    margin-left: 22px;
}

.gacha-rule-badge,
.gacha-reveal-card__badge,
.gacha-summary-row__badge {
    align-self: flex-start;
    margin-top: 12px;
    padding: 5px 10px;
    border-radius: 9px;
    color: rgb(255, 234, 181);
    background-color: rgb(134, 79, 24);
    -unity-font-style: bold;
}

.gacha-rule-badge.is-verified {
    color: rgb(196, 255, 223);
    background-color: rgb(22, 111, 74);
}

.gacha-rule-badge.is-sourced {
    color: rgb(211, 231, 255);
    background-color: rgb(40, 83, 151);
}

.gacha-rule-notice {
    margin-top: 10px;
    color: rgb(255, 208, 137);
    white-space: normal;
}

.gacha-rule-evidence {
    margin-top: 7px;
    color: rgb(188, 202, 230);
    font-size: 14px;
    white-space: normal;
}

.gacha-source-list {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 2px;
}

.gacha-source-button {
    align-self: flex-start;
    height: 36px;
    margin-top: 8px;
    margin-right: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 1px;
    border-radius: 10px;
    border-color: rgba(123, 213, 168, 0.85);
    color: rgb(205, 255, 227);
    background-color: rgba(24, 94, 65, 0.94);
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.gacha-source-button:hover {
    background-color: rgb(34, 126, 86);
}

.gacha-source-button:active {
    scale: 0.96 0.96;
}

.gacha-odds-heading {
    margin-top: 18px;
    margin-bottom: 6px;
    color: rgb(226, 217, 255);
    -unity-font-style: bold;
}

.gacha-odds-scroll {
    flex-grow: 1;
    max-height: 260px;
    margin-bottom: 16px;
}

.gacha-batch-actions {
    justify-content: flex-start;
}

.gacha-batch-actions .gacha-button {
    flex-grow: 1;
    min-width: 0;
    margin-right: 8px;
}

.gacha-opening-statistics {
    margin-top: 12px;
    color: rgb(196, 220, 241);
    font-size: 13px;
    white-space: normal;
}

.gacha-opening-history {
    max-height: 116px;
    margin-top: 6px;
    padding: 6px 8px;
    border-width: 1px;
    border-radius: 10px;
    border-color: rgba(103, 196, 241, 0.45);
    background-color: rgba(7, 24, 45, 0.62);
}

.gacha-history-row {
    min-height: 24px;
    padding-top: 3px;
    padding-bottom: 3px;
    color: rgb(190, 218, 239);
    font-size: 12px;
    white-space: normal;
}

.gacha-odds-row {
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(134, 121, 174, 0.35);
}

.gacha-odds-row__name {
    flex-grow: 1;
    color: rgb(213, 219, 238);
}

.gacha-odds-row__value {
    color: rgb(255, 215, 117);
    -unity-font-style: bold;
}

.gacha-button {
    min-width: 140px;
    height: 52px;
    padding-left: 18px;
    padding-right: 18px;
    border-width: 1px;
    border-radius: 14px;
    border-color: rgba(220, 139, 255, 0.9);
    color: white;
    background-color: rgb(94, 55, 145);
    font-size: 18px;
    -unity-font-style: bold;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.gacha-button:hover {
    background-color: rgb(126, 72, 178);
}

.gacha-button:active {
    scale: 0.96 0.96;
}

.gacha-button--primary {
    background-color: rgb(164, 58, 133);
}

.gacha-button--quiet {
    align-self: flex-start;
    background-color: rgba(55, 61, 91, 0.96);
}

.gacha-stage {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.gacha-theme-particles {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.gacha-theme-particles--reveal {
    left: 8%;
    right: 8%;
    top: 4%;
    bottom: 4%;
}

.theme-particle {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(224, 159, 255);
}

.theme-particle--diamond {
    width: 9px;
    height: 9px;
    border-radius: 1px;
    rotate: 45deg;
}

.theme-particle--dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
}

.theme-particle--shard {
    width: 4px;
    height: 14px;
    border-radius: 2px;
    rotate: -18deg;
    background-color: rgb(112, 224, 255);
}

.gacha-pack-shell {
    width: 330px;
    height: 470px;
    margin-top: 20px;
    margin-bottom: 22px;
    padding: 16px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-width: 3px;
    border-radius: 24px;
    border-color: rgb(219, 127, 255);
    background-color: rgb(79, 37, 108);
}

.gacha-pack-shell__theme-band {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 30px;
    background-color: rgb(219, 127, 255);
}

.gacha-pack-shell__theme-artwork {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 18px;
    bottom: 14px;
    border-radius: 18px;
    opacity: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.gacha-pack-shell__theme-artwork.is-visible {
    opacity: 1;
}

.gacha-pack-shell__art .async-card-image {
    width: 270px;
    height: 390px;
}

.gacha-pack-shell__tear {
    position: absolute;
    left: 0;
    top: 46%;
    height: 7px;
    width: 0;
    background-color: rgb(255, 227, 125);
}

.gacha-reveal-card {
    width: 330px;
    height: 470px;
    margin-top: 16px;
    margin-bottom: 16px;
    align-items: center;
    justify-content: center;
}

.gacha-reveal-aura {
    position: absolute;
    width: 324px;
    height: 324px;
    border-width: 4px;
    border-radius: 162px;
    border-color: rgba(255, 226, 136, 0.72);
    background-color: rgba(255, 207, 91, 0.20);
    opacity: 0;
}

.gacha-reveal-aura.is-highlighted {
    opacity: 0.42;
}

.gacha-reveal-card__art .async-card-image {
    width: 300px;
    height: 420px;
}

.gacha-reveal-card__badge {
    position: absolute;
    right: 0;
    top: 4px;
    margin-top: 0;
    color: rgb(220, 226, 239);
    background-color: rgb(65, 70, 91);
}

.gacha-reveal-card__badge.is-new,
.gacha-summary-row__badge.is-new {
    color: rgb(32, 57, 45);
    background-color: rgb(108, 239, 173);
}

.gacha-reveal-card__metadata {
    margin-top: 6px;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.gacha-reveal__actions {
    flex-direction: row;
    justify-content: center;
}

.gacha-reveal__actions .gacha-button {
    align-self: center;
    margin-left: 8px;
    margin-right: 8px;
}

.gacha-summary {
    align-items: stretch;
    justify-content: flex-start;
}

.gacha-summary-list {
    flex-grow: 1;
    margin-top: 18px;
    margin-bottom: 18px;
}

.gacha-summary-row {
    min-height: 70px;
    margin-bottom: 8px;
    padding: 10px 14px;
    border-width: 1px;
    border-radius: 13px;
    border-color: rgba(137, 127, 175, 0.5);
    background-color: rgba(45, 43, 77, 0.96);
}

.gacha-summary-row__badge {
    align-self: center;
    margin-top: 0;
    margin-left: 12px;
}

.gacha-summary__actions {
    justify-content: center;
}

.gacha-theme--vintage .gacha-opening__shell,
.gacha-theme--vintage .gacha-selected-product {
    border-color: rgba(212, 168, 91, 0.84);
    background-color: rgba(45, 36, 42, 0.98);
}

.gacha-theme--vintage .gacha-pack-shell {
    border-color: rgb(218, 170, 91);
    background-color: rgb(83, 53, 48);
}

.gacha-theme--vintage .gacha-pack-shell__theme-band,
.gacha-theme--vintage .gacha-pack-shell__tear {
    background-color: rgb(239, 205, 126);
}

.gacha-theme--vintage .gacha-reveal-aura {
    border-color: rgba(255, 222, 139, 0.78);
    background-color: rgba(210, 151, 72, 0.24);
}

.gacha-theme--vintage .theme-particle {
    background-color: rgb(244, 208, 132);
}

.gacha-theme--vintage .theme-particle--shard {
    background-color: rgb(202, 133, 76);
}

.gacha-theme--forest .gacha-opening__shell,
.gacha-theme--forest .gacha-selected-product {
    border-color: rgba(100, 190, 126, 0.82);
    background-color: rgba(27, 51, 43, 0.98);
}

.gacha-theme--forest .gacha-pack-shell {
    border-color: rgb(135, 213, 143);
    background-color: rgb(35, 82, 61);
}

.gacha-theme--forest .gacha-pack-shell__theme-band,
.gacha-theme--forest .gacha-pack-shell__tear {
    background-color: rgb(220, 214, 103);
}

.gacha-theme--forest .gacha-reveal-aura {
    border-color: rgba(186, 247, 139, 0.78);
    background-color: rgba(87, 202, 118, 0.22);
}

.gacha-theme--forest .theme-particle {
    background-color: rgb(176, 238, 120);
}

.gacha-theme--forest .theme-particle--shard {
    background-color: rgb(246, 223, 104);
}

.gacha-theme--ruby .gacha-opening__shell,
.gacha-theme--ruby .gacha-selected-product {
    border-color: rgba(235, 96, 115, 0.88);
    background-color: rgba(61, 29, 44, 0.98);
}

.gacha-theme--ruby .gacha-pack-shell {
    border-color: rgb(255, 117, 128);
    background-color: rgb(121, 34, 54);
}

.gacha-theme--ruby .gacha-pack-shell__theme-band,
.gacha-theme--ruby .gacha-pack-shell__tear {
    background-color: rgb(236, 226, 222);
}

.gacha-theme--ruby .gacha-reveal-aura {
    border-color: rgba(255, 129, 140, 0.82);
    background-color: rgba(229, 61, 88, 0.24);
}

.gacha-theme--ruby .theme-particle {
    background-color: rgb(255, 113, 128);
}

.gacha-theme--ruby .theme-particle--shard {
    background-color: rgb(255, 192, 105);
}

.gacha-theme--electric .gacha-opening__shell,
.gacha-theme--electric .gacha-selected-product {
    border-color: rgba(80, 184, 255, 0.86);
    background-color: rgba(24, 39, 74, 0.98);
}

.gacha-theme--electric .gacha-pack-shell {
    border-color: rgb(83, 207, 255);
    background-color: rgb(38, 64, 142);
}

.gacha-theme--electric .gacha-pack-shell__theme-band,
.gacha-theme--electric .gacha-pack-shell__tear {
    background-color: rgb(255, 92, 184);
}

.gacha-theme--electric .gacha-reveal-aura {
    border-color: rgba(101, 220, 255, 0.86);
    background-color: rgba(80, 137, 255, 0.26);
}

.gacha-theme--electric .theme-particle {
    background-color: rgb(83, 221, 255);
}

.gacha-theme--electric .theme-particle--shard {
    background-color: rgb(255, 92, 184);
}

.gacha-theme--gallery .gacha-opening__shell,
.gacha-theme--gallery .gacha-selected-product {
    border-color: rgba(192, 119, 255, 0.90);
    background-color: rgba(52, 27, 72, 0.98);
}

.gacha-theme--gallery .gacha-pack-shell {
    border-color: rgb(220, 129, 255);
    background-color: rgb(92, 42, 120);
}

.gacha-theme--gallery .gacha-pack-shell__theme-band {
    background-color: rgb(255, 102, 91);
}

.gacha-theme--gallery .gacha-pack-shell__tear {
    background-color: rgb(111, 224, 255);
}

.gacha-theme--gallery .gacha-reveal-aura {
    border-color: rgba(239, 145, 255, 0.88);
    background-color: rgba(255, 88, 157, 0.25);
}

.gacha-theme--gallery .theme-particle {
    background-color: rgb(230, 137, 255);
}

.gacha-theme--gallery .theme-particle--shard {
    background-color: rgb(255, 107, 113);
}

.reduce-motion .gacha-button,
.reduce-motion .gacha-product-row {
    transition-duration: 0s;
}

.reduce-motion .gacha-theme-particles {
    display: none;
}

.reduce-motion .gacha-button:active,
.reduce-motion .gacha-product-row:hover {
    scale: 1 1;
}

.gacha-summary__actions .gacha-button {
    margin-left: 8px;
    margin-right: 8px;
}

.collection-browser {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 36px;
    color: rgb(239, 247, 255);
    background-color: rgba(5, 10, 22, 0.94);
}

.collection-browser__shell {
    flex-grow: 1;
    max-width: 1040px;
    align-self: center;
    width: 100%;
    padding: 28px;
    border-radius: 28px;
    border-width: 2px;
    border-color: rgba(76, 169, 242, 0.75);
    background-color: rgba(16, 28, 48, 0.97);
}

.collection-browser__header,
.card-page__header,
.set-row,
.card-row {
    flex-direction: row;
    align-items: center;
}

.collection-browser__heading,
.card-page__heading,
.browser-row__copy {
    flex-grow: 1;
}

.collection-browser__actions {
    flex-direction: row;
    align-items: center;
}

.browser-button--pokedex {
    margin-right: 10px;
    border-color: rgba(117, 226, 189, 0.9);
    background-color: rgb(33, 126, 104);
}

.collection-browser__title,
.card-page__title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(250, 253, 255);
}

.collection-browser__subtitle,
.collection-browser__status,
.card-page__count,
.browser-row__metadata,
.details-panel__metadata {
    color: rgb(160, 191, 218);
    font-size: 17px;
}

.collection-browser__status {
    margin-top: 12px;
    margin-bottom: 14px;
}

.collection-browser__status.is-error {
    color: rgb(255, 140, 148);
}

.browser-page,
.browser-list {
    flex-grow: 1;
}

.card-page__header {
    margin-bottom: 12px;
}

.card-page__heading {
    margin-left: 18px;
}

.browser-button {
    min-width: 140px;
    height: 52px;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(100, 197, 255, 0.9);
    background-color: rgb(30, 105, 160);
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.browser-button:hover {
    background-color: rgb(45, 137, 196);
}

.browser-button:active {
    scale: 0.96 0.96;
}

.browser-button--quiet {
    background-color: rgba(40, 66, 92, 0.9);
}

.browser-button--filter {
    min-width: 132px;
    height: 44px;
    margin-left: 8px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 15px;
}

.browser-button--filter.is-selected {
    border-color: rgb(255, 213, 100);
    background-color: rgb(126, 91, 24);
    color: rgb(255, 245, 205);
}

.collection-filters {
    margin-bottom: 12px;
    padding: 12px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(91, 141, 181, 0.45);
    background-color: rgba(18, 35, 56, 0.92);
}

.collection-filter {
    color: rgb(210, 230, 246);
    font-size: 14px;
}

.collection-filter--search {
    width: 250px;
    margin-right: 10px;
}

.collection-filter--rarity {
    width: 210px;
}

.collection-filter__toggles {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
}

.collection-filter .unity-base-text-field__input,
.collection-filter .unity-base-popup-field__input {
    min-height: 36px;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(100, 197, 255, 0.55);
    background-color: rgb(10, 23, 39);
    color: white;
}

.collection-filter__empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 28px;
    border-radius: 16px;
    background-color: rgba(14, 28, 46, 0.88);
    color: rgb(160, 191, 218);
    font-size: 19px;
    -unity-text-align: middle-center;
}

.set-row,
.card-row {
    height: 100%;
    margin: 5px 8px;
    padding: 10px 16px;
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(91, 141, 181, 0.45);
    background-color: rgba(29, 49, 73, 0.96);
    transition-property: scale, background-color, border-color;
    transition-duration: 0.12s;
}

.set-row:hover,
.card-row:hover {
    scale: 1.01 1.01;
    border-color: rgb(89, 193, 255);
    background-color: rgb(34, 64, 92);
}

.card-row.is-unowned {
    opacity: 0.62;
}

.card-row.is-new {
    border-color: rgb(255, 207, 88);
    background-color: rgb(55, 58, 71);
}

.browser-row__copy {
    margin-left: 18px;
}

.browser-row__title,
.details-panel__name {
    color: white;
    font-size: 23px;
    -unity-font-style: bold;
    white-space: normal;
}

.card-row__rarity {
    margin-top: 8px;
    color: rgb(255, 211, 105);
    font-size: 17px;
}

.card-row__progress {
    min-width: 112px;
    margin-left: 12px;
    align-items: flex-end;
}

.card-row__owned,
.details-panel__progress {
    color: rgb(151, 179, 202);
    font-size: 15px;
}

.card-row__owned.is-owned,
.details-panel__progress {
    color: rgb(145, 231, 183);
}

.card-row__new,
.details-panel__new {
    margin-bottom: 8px;
    padding: 4px 9px;
    border-radius: 9px;
    background-color: rgb(183, 123, 22);
    color: rgb(255, 246, 209);
    font-size: 13px;
    -unity-font-style: bold;
}

.async-card-image {
    position: relative;
    width: 82px;
    height: 110px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 10px;
    background-color: rgb(10, 20, 34);
}

.async-card-image__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.async-card-image__status {
    position: absolute;
    left: 5px;
    right: 5px;
    top: 34px;
    color: rgb(201, 218, 232);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.async-card-image__retry {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 7px;
    height: 26px;
    border-radius: 7px;
    background-color: rgb(145, 52, 61);
    color: white;
    font-size: 11px;
}

.details-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.details-panel__scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.74);
}

.details-panel__card {
    width: 520px;
    max-width: 88%;
    padding: 28px;
    align-items: center;
    border-radius: 26px;
    border-width: 2px;
    border-color: rgb(93, 200, 255);
    background-color: rgb(18, 36, 58);
}

.details-panel__art .async-card-image {
    width: 280px;
    height: 390px;
}

.details-panel__name {
    margin-top: 18px;
    -unity-text-align: middle-center;
}

.details-panel__languages {
    margin-top: 14px;
    padding: 4px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(100, 197, 255, 0.48);
    background-color: rgba(8, 22, 39, 0.9);
}

.details-panel__language {
    min-width: 58px;
    height: 38px;
    margin-left: 3px;
    margin-right: 3px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(109, 162, 204, 0.45);
    background-color: rgba(27, 53, 78, 0.92);
    color: rgb(195, 219, 239);
    font-size: 15px;
    -unity-font-style: bold;
    transition-property: background-color, border-color, color;
    transition-duration: 0.1s;
}

.details-panel__language:hover {
    border-color: rgb(118, 205, 255);
    background-color: rgb(39, 85, 121);
    color: white;
}

.details-panel__language.is-selected {
    border-color: rgb(255, 219, 92);
    background-color: rgb(187, 48, 58);
    color: white;
}

.reduce-motion .details-panel__language {
    transition-duration: 0s;
}

.details-panel__metadata {
    margin-top: 8px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.details-panel__progress {
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.details-panel__new {
    margin-top: 14px;
    margin-bottom: 0;
}

/* Original trainer-terminal visual language shared by the primary game screens. */
.content-management,
.gacha-opening,
.collection-browser {
    background-color: rgb(7, 19, 39);
}

.content-management__shell,
.gacha-opening__shell,
.collection-browser__shell {
    border-color: rgb(76, 190, 235);
    background-color: rgb(16, 43, 76);
}

.content-management__title,
.gacha-opening__title,
.collection-browser__title,
.card-page__title {
    color: rgb(248, 252, 255);
}

.content-management__subtitle,
.gacha-opening__subtitle,
.collection-browser__subtitle,
.collection-browser__status,
.card-page__count {
    color: rgb(177, 211, 235);
}

.content-package-row,
.gacha-product-row,
.gacha-summary-row,
.set-row,
.card-row {
    border-color: rgb(184, 202, 216);
    background-color: rgb(243, 247, 250);
}

.content-package-row__name,
.gacha-product-row .gacha-product-row__name,
.gacha-summary-row .gacha-summary-row__name,
.set-row .browser-row__title,
.card-row .browser-row__title {
    color: rgb(21, 43, 67);
}

.content-package-row__metadata,
.gacha-product-row .gacha-product-row__metadata,
.gacha-summary-row .gacha-summary-row__metadata,
.set-row .browser-row__metadata,
.card-row .browser-row__metadata {
    color: rgb(74, 101, 126);
}

.content-package-row:hover,
.gacha-product-row:hover,
.set-row:hover,
.card-row:hover {
    border-color: rgb(67, 157, 221);
    background-color: rgb(222, 239, 249);
}

.card-row.is-new {
    border-color: rgb(225, 160, 37);
    background-color: rgb(255, 245, 207);
}

.gacha-button,
.browser-button {
    border-color: rgb(103, 196, 241);
    background-color: rgb(43, 118, 190);
}

.gacha-button:hover,
.browser-button:hover {
    background-color: rgb(55, 146, 216);
}

.gacha-button--primary,
.browser-button--pokedex {
    border-color: rgb(255, 115, 121);
    background-color: rgb(205, 49, 61);
}

.gacha-button--primary:hover,
.browser-button--pokedex:hover {
    background-color: rgb(230, 63, 73);
}

.content-button {
    border-color: rgb(103, 196, 241);
    background-color: rgb(43, 118, 190);
}

.content-button--primary {
    border-color: rgb(255, 115, 121);
    background-color: rgb(205, 49, 61);
}

.content-button--danger {
    border-color: rgb(235, 97, 104);
    background-color: rgb(139, 42, 50);
}

.details-panel__card {
    border-color: rgb(224, 57, 67);
    background-color: rgb(246, 249, 251);
}

.details-panel__card .details-panel__name {
    color: rgb(21, 43, 67);
}

.details-panel__card .details-panel__metadata {
    color: rgb(72, 98, 122);
}

.details-panel__card .details-panel__progress {
    color: rgb(26, 125, 85);
}

.details-panel__languages {
    border-color: rgb(146, 177, 200);
    background-color: rgb(225, 234, 241);
}

.details-panel__language {
    border-color: rgb(133, 164, 188);
    background-color: rgb(240, 245, 248);
    color: rgb(47, 76, 101);
}

.details-panel__language:hover {
    border-color: rgb(55, 146, 216);
    background-color: rgb(214, 235, 249);
    color: rgb(21, 43, 67);
}

.details-panel__language.is-selected {
    border-color: rgb(229, 164, 35);
    background-color: rgb(205, 49, 61);
    color: white;
}

/* Safe Area is added as inline padding on the full-screen background roots.
   Compact rules keep controls reachable after asymmetric display insets. */
.content-management.mobile-layout--compact .content-management__shell,
.gacha-opening.mobile-layout--compact .gacha-opening__shell,
.collection-browser.mobile-layout--compact .collection-browser__shell {
    padding: 18px;
}

.content-management.mobile-layout--compact .content-management__header,
.content-management.mobile-layout--compact .content-management__header-actions,
.gacha-opening.mobile-layout--compact .gacha-opening__header,
.collection-browser.mobile-layout--compact .collection-browser__header,
.collection-browser.mobile-layout--compact .card-page__header,
.collection-browser.mobile-layout--compact .collection-browser__actions {
    flex-wrap: wrap;
}

.content-management.mobile-layout--compact .content-management__filters {
    flex-direction: column;
    align-items: stretch;
}

.content-management.mobile-layout--compact .content-management__search,
.content-management.mobile-layout--compact .content-management__filter {
    width: 100%;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 6px;
}

.content-management__selection-actions .content-button {
    min-height: 50px;
    height: 50px;
}

.content-package-row__name {
    white-space: normal;
}

.content-management.mobile-layout--compact .content-package-row {
    height: auto;
    min-height: 236px;
    flex-direction: column;
    align-items: stretch;
}

.content-management.mobile-layout--compact .content-package-row__controls {
    width: 100%;
    min-width: 0;
    margin-left: 0;
    margin-top: 12px;
}

.content-management.mobile-layout--compact .content-package-row__actions {
    height: auto;
    min-height: 104px;
    flex-wrap: wrap;
    overflow: visible;
}

.content-management.mobile-layout--compact .content-package-row__actions .content-button {
    position: relative;
    left: auto;
    width: auto;
    min-width: 112px;
    max-width: 100%;
    flex-grow: 1;
    margin-right: 6px;
    margin-bottom: 6px;
}
