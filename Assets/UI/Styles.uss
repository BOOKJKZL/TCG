.main-menu { flex-direction: column; align-items: center; justify-content: center; padding: 16px; }

.content-management {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 30px;
    color: rgb(236, 247, 255);
    background-color: rgba(4, 12, 23, 0.96);
}

.content-management__shell {
    flex-grow: 1;
    width: 100%;
    max-width: 1080px;
    align-self: center;
    padding: 26px;
    border-width: 2px;
    border-radius: 28px;
    border-color: rgba(66, 196, 213, 0.7);
    background-color: rgba(16, 34, 49, 0.98);
}

.content-management__header,
.content-management__header-actions,
.content-package-row,
.content-package-row__actions {
    flex-direction: row;
    align-items: center;
}

.content-management__heading,
.content-package-row__copy {
    flex-grow: 1;
}

.content-management__title {
    color: white;
    font-size: 34px;
    -unity-font-style: bold;
}

.content-management__subtitle,
.content-package-row__metadata {
    color: rgb(159, 190, 208);
    font-size: 16px;
    white-space: normal;
}

.content-management__header-actions .content-button {
    margin-left: 10px;
}

.content-management__catalog-status {
    margin-top: 14px;
    padding: 10px 14px;
    border-radius: 12px;
    color: rgb(211, 237, 242);
    background-color: rgba(35, 84, 98, 0.92);
}

.content-management__catalog-status.is-error {
    color: rgb(255, 225, 228);
    background-color: rgba(133, 42, 55, 0.92);
}

.content-management__empty {
    flex-grow: 1;
    margin-top: 16px;
    padding: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 18px;
    color: rgb(164, 194, 211);
    background-color: rgba(10, 25, 38, 0.88);
    font-size: 19px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.content-management__list {
    flex-grow: 1;
    margin-top: 14px;
}

.content-package-row {
    min-height: 148px;
    margin: 6px 4px;
    padding: 18px;
    border-width: 1px;
    border-radius: 18px;
    border-color: rgba(88, 161, 174, 0.55);
    background-color: rgba(25, 51, 67, 0.96);
}

.content-package-row__name {
    color: white;
    font-size: 23px;
    -unity-font-style: bold;
}

.content-package-row__metadata {
    margin-top: 5px;
}

.content-package-row__status {
    margin-top: 10px;
    color: rgb(147, 218, 192);
    white-space: normal;
}

.content-package-row__status.is-error {
    color: rgb(255, 151, 157);
}

.content-package-row__status.is-success {
    color: rgb(126, 239, 177);
    -unity-font-style: bold;
}

.content-package-row__controls {
    width: 410px;
    margin-left: 18px;
}

.content-package-row__progress {
    height: 28px;
    margin-bottom: 12px;
}

.content-package-row__actions {
    justify-content: flex-end;
}

.content-button {
    min-width: 128px;
    height: 48px;
    margin-left: 8px;
    padding-left: 16px;
    padding-right: 16px;
    border-width: 1px;
    border-radius: 13px;
    border-color: rgba(106, 222, 231, 0.9);
    color: white;
    background-color: rgb(24, 119, 137);
    font-size: 16px;
    -unity-font-style: bold;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.content-button:hover {
    background-color: rgb(32, 151, 169);
}

.content-button:active {
    scale: 0.96 0.96;
}

.reduce-motion .content-button {
    transition-duration: 0s;
}

.reduce-motion .content-button:active {
    scale: 1 1;
}

.content-button--primary {
    background-color: rgb(37, 137, 104);
}

.content-button--quiet {
    background-color: rgba(44, 70, 87, 0.96);
}

.content-button--danger {
    border-color: rgba(238, 121, 132, 0.9);
    background-color: rgb(137, 52, 65);
}

.gacha-opening {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 36px;
    color: rgb(240, 247, 255);
    background-color: rgba(4, 9, 20, 0.94);
}

.gacha-opening__shell {
    flex-grow: 1;
    width: 100%;
    max-width: 1080px;
    align-self: center;
    padding: 28px;
    border-width: 2px;
    border-radius: 28px;
    border-color: rgba(203, 91, 255, 0.72);
    background-color: rgba(23, 22, 48, 0.97);
}

.gacha-opening__header,
.gacha-product-row,
.gacha-selected-product,
.gacha-odds-row,
.gacha-summary-row,
.gacha-summary__actions {
    flex-direction: row;
    align-items: center;
}

.gacha-opening__heading,
.gacha-product-row__copy,
.gacha-selected-product__body,
.gacha-summary-row__copy {
    flex-grow: 1;
}

.gacha-opening__title,
.gacha-stage__title {
    color: white;
    font-size: 34px;
    -unity-font-style: bold;
}

.gacha-opening__subtitle,
.gacha-selected-product__metadata,
.gacha-product-row__metadata,
.gacha-stage__hint,
.gacha-reveal-progress,
.gacha-reveal-card__metadata,
.gacha-summary-row__metadata {
    color: rgb(174, 186, 219);
    font-size: 16px;
    white-space: normal;
}

.gacha-opening__status {
    margin-top: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    color: rgb(221, 234, 247);
    background-color: rgba(48, 78, 104, 0.88);
}

.gacha-opening__status.is-error {
    color: rgb(255, 225, 228);
    background-color: rgba(133, 42, 55, 0.92);
}

.gacha-page {
    flex-grow: 1;
    margin-top: 16px;
}

.gacha-selection {
    flex-direction: row;
}

.gacha-product-list {
    width: 46%;
    flex-shrink: 0;
    margin-right: 18px;
}

.gacha-product-row {
    height: 100%;
    margin: 5px 7px;
    padding: 10px 14px;
    border-width: 1px;
    border-radius: 16px;
    border-color: rgba(125, 109, 182, 0.55);
    background-color: rgba(42, 41, 78, 0.96);
    transition-property: scale, background-color, border-color;
    transition-duration: 0.12s;
}

.gacha-product-row:hover {
    scale: 1.01 1.01;
    border-color: rgb(215, 119, 255);
    background-color: rgb(57, 50, 100);
}

.gacha-product-row__cover .async-card-image {
    width: 72px;
    height: 98px;
}

.gacha-product-row__copy {
    margin-left: 14px;
}

.gacha-product-row__name,
.gacha-selected-product__name,
.gacha-reveal-card__name,
.gacha-summary-row__name {
    color: white;
    font-size: 21px;
    -unity-font-style: bold;
    white-space: normal;
}

.gacha-selected-product {
    flex-grow: 1;
    padding: 22px;
    border-width: 1px;
    border-radius: 22px;
    border-color: rgba(198, 119, 238, 0.66);
    background-color: rgba(38, 34, 69, 0.98);
}

.gacha-selected-product__art {
    width: 210px;
    align-items: center;
    justify-content: center;
}

.gacha-selected-product__art .async-card-image {
    width: 180px;
    height: 250px;
}

.gacha-selected-product__body {
    align-self: stretch;
    margin-left: 22px;
}

.gacha-rule-badge,
.gacha-reveal-card__badge,
.gacha-summary-row__badge {
    align-self: flex-start;
    margin-top: 12px;
    padding: 5px 10px;
    border-radius: 9px;
    color: rgb(255, 234, 181);
    background-color: rgb(134, 79, 24);
    -unity-font-style: bold;
}

.gacha-rule-badge.is-verified {
    color: rgb(196, 255, 223);
    background-color: rgb(22, 111, 74);
}

.gacha-rule-notice {
    margin-top: 10px;
    color: rgb(255, 208, 137);
    white-space: normal;
}

.gacha-source-button {
    align-self: flex-start;
    height: 36px;
    margin-top: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 1px;
    border-radius: 10px;
    border-color: rgba(123, 213, 168, 0.85);
    color: rgb(205, 255, 227);
    background-color: rgba(24, 94, 65, 0.94);
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.gacha-source-button:hover {
    background-color: rgb(34, 126, 86);
}

.gacha-source-button:active {
    scale: 0.96 0.96;
}

.gacha-odds-heading {
    margin-top: 18px;
    margin-bottom: 6px;
    color: rgb(226, 217, 255);
    -unity-font-style: bold;
}

.gacha-odds-scroll {
    flex-grow: 1;
    max-height: 260px;
    margin-bottom: 16px;
}

.gacha-odds-row {
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(134, 121, 174, 0.35);
}

.gacha-odds-row__name {
    flex-grow: 1;
    color: rgb(213, 219, 238);
}

.gacha-odds-row__value {
    color: rgb(255, 215, 117);
    -unity-font-style: bold;
}

.gacha-button {
    min-width: 140px;
    height: 52px;
    padding-left: 18px;
    padding-right: 18px;
    border-width: 1px;
    border-radius: 14px;
    border-color: rgba(220, 139, 255, 0.9);
    color: white;
    background-color: rgb(94, 55, 145);
    font-size: 18px;
    -unity-font-style: bold;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.gacha-button:hover {
    background-color: rgb(126, 72, 178);
}

.gacha-button:active {
    scale: 0.96 0.96;
}

.gacha-button--primary {
    background-color: rgb(164, 58, 133);
}

.gacha-button--quiet {
    align-self: flex-start;
    background-color: rgba(55, 61, 91, 0.96);
}

.gacha-stage {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.gacha-pack-shell {
    width: 330px;
    height: 470px;
    margin-top: 20px;
    margin-bottom: 22px;
    padding: 16px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-width: 3px;
    border-radius: 24px;
    border-color: rgb(219, 127, 255);
    background-color: rgb(79, 37, 108);
}

.gacha-pack-shell__art .async-card-image {
    width: 270px;
    height: 390px;
}

.gacha-pack-shell__tear {
    position: absolute;
    left: 0;
    top: 46%;
    height: 7px;
    width: 0;
    background-color: rgb(255, 227, 125);
}

.gacha-reveal-card {
    width: 330px;
    height: 470px;
    margin-top: 16px;
    margin-bottom: 16px;
    align-items: center;
    justify-content: center;
}

.gacha-reveal-card__art .async-card-image {
    width: 300px;
    height: 420px;
}

.gacha-reveal-card__badge {
    position: absolute;
    right: 0;
    top: 4px;
    margin-top: 0;
    color: rgb(220, 226, 239);
    background-color: rgb(65, 70, 91);
}

.gacha-reveal-card__badge.is-new,
.gacha-summary-row__badge.is-new {
    color: rgb(32, 57, 45);
    background-color: rgb(108, 239, 173);
}

.gacha-reveal-card__metadata {
    margin-top: 6px;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.gacha-reveal__actions {
    flex-direction: row;
    justify-content: center;
}

.gacha-reveal__actions .gacha-button {
    align-self: center;
    margin-left: 8px;
    margin-right: 8px;
}

.gacha-summary {
    align-items: stretch;
    justify-content: flex-start;
}

.gacha-summary-list {
    flex-grow: 1;
    margin-top: 18px;
    margin-bottom: 18px;
}

.gacha-summary-row {
    min-height: 70px;
    margin-bottom: 8px;
    padding: 10px 14px;
    border-width: 1px;
    border-radius: 13px;
    border-color: rgba(137, 127, 175, 0.5);
    background-color: rgba(45, 43, 77, 0.96);
}

.gacha-summary-row__badge {
    align-self: center;
    margin-top: 0;
    margin-left: 12px;
}

.gacha-summary__actions {
    justify-content: center;
}

.gacha-summary__actions .gacha-button {
    margin-left: 8px;
    margin-right: 8px;
}

.collection-browser {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 36px;
    color: rgb(239, 247, 255);
    background-color: rgba(5, 10, 22, 0.94);
}

.collection-browser__shell {
    flex-grow: 1;
    max-width: 1040px;
    align-self: center;
    width: 100%;
    padding: 28px;
    border-radius: 28px;
    border-width: 2px;
    border-color: rgba(76, 169, 242, 0.75);
    background-color: rgba(16, 28, 48, 0.97);
}

.collection-browser__header,
.card-page__header,
.set-row,
.card-row {
    flex-direction: row;
    align-items: center;
}

.collection-browser__heading,
.card-page__heading,
.browser-row__copy {
    flex-grow: 1;
}

.collection-browser__title,
.card-page__title {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(250, 253, 255);
}

.collection-browser__subtitle,
.collection-browser__status,
.card-page__count,
.browser-row__metadata,
.details-panel__metadata {
    color: rgb(160, 191, 218);
    font-size: 17px;
}

.collection-browser__status {
    margin-top: 12px;
    margin-bottom: 14px;
}

.collection-browser__status.is-error {
    color: rgb(255, 140, 148);
}

.browser-page,
.browser-list {
    flex-grow: 1;
}

.card-page__header {
    margin-bottom: 12px;
}

.card-page__heading {
    margin-left: 18px;
}

.browser-button {
    min-width: 140px;
    height: 52px;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(100, 197, 255, 0.9);
    background-color: rgb(30, 105, 160);
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    transition-property: scale, background-color;
    transition-duration: 0.12s;
}

.browser-button:hover {
    background-color: rgb(45, 137, 196);
}

.browser-button:active {
    scale: 0.96 0.96;
}

.browser-button--quiet {
    background-color: rgba(40, 66, 92, 0.9);
}

.browser-button--filter {
    min-width: 132px;
    height: 44px;
    margin-left: 8px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 15px;
}

.browser-button--filter.is-selected {
    border-color: rgb(255, 213, 100);
    background-color: rgb(126, 91, 24);
    color: rgb(255, 245, 205);
}

.collection-filters {
    margin-bottom: 12px;
    padding: 12px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(91, 141, 181, 0.45);
    background-color: rgba(18, 35, 56, 0.92);
}

.collection-filter {
    color: rgb(210, 230, 246);
    font-size: 14px;
}

.collection-filter--search {
    width: 250px;
    margin-right: 10px;
}

.collection-filter--rarity {
    width: 210px;
}

.collection-filter__toggles {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
}

.collection-filter .unity-base-text-field__input,
.collection-filter .unity-base-popup-field__input {
    min-height: 36px;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgba(100, 197, 255, 0.55);
    background-color: rgb(10, 23, 39);
    color: white;
}

.collection-filter__empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 28px;
    border-radius: 16px;
    background-color: rgba(14, 28, 46, 0.88);
    color: rgb(160, 191, 218);
    font-size: 19px;
    -unity-text-align: middle-center;
}

.set-row,
.card-row {
    height: 100%;
    margin: 5px 8px;
    padding: 10px 16px;
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(91, 141, 181, 0.45);
    background-color: rgba(29, 49, 73, 0.96);
    transition-property: scale, background-color, border-color;
    transition-duration: 0.12s;
}

.set-row:hover,
.card-row:hover {
    scale: 1.01 1.01;
    border-color: rgb(89, 193, 255);
    background-color: rgb(34, 64, 92);
}

.card-row.is-unowned {
    opacity: 0.62;
}

.card-row.is-new {
    border-color: rgb(255, 207, 88);
    background-color: rgb(55, 58, 71);
}

.browser-row__copy {
    margin-left: 18px;
}

.browser-row__title,
.details-panel__name {
    color: white;
    font-size: 23px;
    -unity-font-style: bold;
    white-space: normal;
}

.card-row__rarity {
    margin-top: 8px;
    color: rgb(255, 211, 105);
    font-size: 17px;
}

.card-row__progress {
    min-width: 112px;
    margin-left: 12px;
    align-items: flex-end;
}

.card-row__owned,
.details-panel__progress {
    color: rgb(151, 179, 202);
    font-size: 15px;
}

.card-row__owned.is-owned,
.details-panel__progress {
    color: rgb(145, 231, 183);
}

.card-row__new,
.details-panel__new {
    margin-bottom: 8px;
    padding: 4px 9px;
    border-radius: 9px;
    background-color: rgb(183, 123, 22);
    color: rgb(255, 246, 209);
    font-size: 13px;
    -unity-font-style: bold;
}

.async-card-image {
    position: relative;
    width: 82px;
    height: 110px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 10px;
    background-color: rgb(10, 20, 34);
}

.async-card-image__art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.async-card-image__status {
    position: absolute;
    left: 5px;
    right: 5px;
    top: 34px;
    color: rgb(201, 218, 232);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.async-card-image__retry {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 7px;
    height: 26px;
    border-radius: 7px;
    background-color: rgb(145, 52, 61);
    color: white;
    font-size: 11px;
}

.details-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.details-panel__scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.74);
}

.details-panel__card {
    width: 520px;
    max-width: 88%;
    padding: 28px;
    align-items: center;
    border-radius: 26px;
    border-width: 2px;
    border-color: rgb(93, 200, 255);
    background-color: rgb(18, 36, 58);
}

.details-panel__art .async-card-image {
    width: 280px;
    height: 390px;
}

.details-panel__name {
    margin-top: 18px;
    -unity-text-align: middle-center;
}

.details-panel__metadata {
    margin-top: 8px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.details-panel__progress {
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.details-panel__new {
    margin-top: 14px;
    margin-bottom: 0;
}
