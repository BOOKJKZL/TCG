<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Styles.uss" />
    <ui:VisualElement name="collection-browser" class="collection-browser-host">
        <ui:VisualElement name="collection-body" class="collection-browser__body">
            <ui:Label name="browser-status" class="collection-browser__status is-hidden" />

            <ui:VisualElement name="collection-error-panel" class="player-error-panel is-hidden">
                <ui:Label name="collection-error-title" class="player-error-panel__title" />
                <ui:Label name="collection-error-body" class="player-error-panel__body" />
                <ui:VisualElement class="player-error-panel__actions">
                    <ui:VisualElement name="collection-error-retry" class="collection-action collection-action--primary">
                        <ui:Label class="collection-action__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="collection-error-manage" class="collection-action">
                        <ui:Label class="collection-action__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="collection-error-home" class="collection-action collection-action--quiet">
                        <ui:Label class="collection-action__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="collection-zero-content" class="zero-content-panel is-hidden">
                <ui:Label name="collection-zero-content-text" class="zero-content-panel__text" />
                <ui:VisualElement name="collection-manage-content-button" class="collection-action collection-action--primary zero-content-action">
                    <ui:Label class="collection-action__label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="set-page" class="browser-page">
                <ui:ListView name="set-list" class="browser-list collection-set-list" virtualization-method="DynamicHeight" />
            </ui:VisualElement>

            <ui:VisualElement name="card-page" class="browser-page is-hidden">
                <ui:VisualElement class="card-page__header">
                    <ui:VisualElement name="back-to-sets-button" class="collection-action collection-action--quiet">
                        <ui:Label class="collection-action__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card-page__heading">
                        <ui:Label name="card-page-title" class="card-page__title" />
                        <ui:Label name="card-count" class="card-page__count" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="open-filters-button" class="collection-action collection-action--quiet collection-filter-sheet-action">
                    <ui:Label class="collection-action__label" />
                </ui:VisualElement>
                <ui:VisualElement name="collection-filters" class="collection-filters">
                    <ui:TextField name="card-search" class="collection-filter collection-filter--search" />
                    <ui:DropdownField name="rarity-filter" class="collection-filter collection-filter--rarity" />
                    <ui:DropdownField name="card-sort" class="collection-filter collection-filter--sort" />
                    <ui:VisualElement class="collection-filter__toggles">
                        <ui:VisualElement name="owned-only-button" class="collection-action collection-action--filter">
                            <ui:Label class="collection-action__label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="new-only-button" class="collection-action collection-action--filter">
                            <ui:Label class="collection-action__label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="clear-filters-button" class="collection-action collection-action--quiet collection-action--filter">
                            <ui:Label class="collection-action__label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="filter-empty" class="collection-filter__empty is-hidden" />
                <ui:ListView name="card-list" class="browser-list collection-card-grid" virtualization-method="DynamicHeight" />
            </ui:VisualElement>

            <ui:ScrollView name="detail-content" class="collection-detail" mode="Vertical">
                <ui:VisualElement name="detail-art-slot" class="collection-detail__art" />
                <ui:Label name="detail-new-badge" class="collection-detail__new is-hidden" />
                <ui:VisualElement name="detail-language-switcher" class="collection-detail__languages is-hidden" />
                <ui:Label name="detail-name" class="collection-detail__name" />
                <ui:Label name="detail-metadata" class="collection-detail__metadata" />
                <ui:Label name="detail-progress" class="collection-detail__progress" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
