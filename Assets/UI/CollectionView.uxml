<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Styles.uss" />
    <ui:VisualElement name="collection-browser" class="collection-browser">
        <ui:VisualElement class="collection-browser__shell">
            <ui:VisualElement name="trainer-device-rail" class="trainer-device-rail">
                <ui:VisualElement class="trainer-device-rail__red" />
                <ui:VisualElement class="trainer-device-rail__yellow" />
                <ui:VisualElement class="trainer-device-rail__blue" />
            </ui:VisualElement>
            <ui:VisualElement class="collection-browser__header">
                <ui:VisualElement name="trainer-status-lights" class="trainer-status-lights">
                    <ui:VisualElement class="trainer-status-light trainer-status-light--lens" />
                    <ui:VisualElement class="trainer-status-light trainer-status-light--red" />
                    <ui:VisualElement class="trainer-status-light trainer-status-light--yellow" />
                    <ui:VisualElement class="trainer-status-light trainer-status-light--green" />
                </ui:VisualElement>
                <ui:VisualElement class="collection-browser__heading">
                    <ui:Label name="collection-title" class="collection-browser__title" />
                    <ui:Label name="collection-subtitle" class="collection-browser__subtitle" />
                </ui:VisualElement>
                <ui:VisualElement class="collection-browser__actions">
                    <ui:Button name="pokedex-button" class="browser-button browser-button--pokedex" />
                    <ui:Button name="menu-button" class="browser-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="browser-status" class="collection-browser__status" />

            <ui:VisualElement name="set-page" class="browser-page">
                <ui:ListView name="set-list" class="browser-list" />
            </ui:VisualElement>

            <ui:VisualElement name="card-page" class="browser-page" style="display: none;">
                <ui:VisualElement class="card-page__header">
                    <ui:Button name="back-to-sets-button" class="browser-button browser-button--quiet" />
                    <ui:VisualElement class="card-page__heading">
                        <ui:Label name="card-page-title" class="card-page__title" />
                        <ui:Label name="card-count" class="card-page__count" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="collection-filters">
                    <ui:TextField name="card-search" class="collection-filter collection-filter--search" />
                    <ui:DropdownField name="rarity-filter" class="collection-filter collection-filter--rarity" />
                    <ui:VisualElement class="collection-filter__toggles">
                        <ui:Button name="owned-only-button" class="browser-button browser-button--filter" />
                        <ui:Button name="new-only-button" class="browser-button browser-button--filter" />
                        <ui:Button name="clear-filters-button" class="browser-button browser-button--quiet browser-button--filter" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="filter-empty" class="collection-filter__empty" style="display: none;" />
                <ui:ListView name="card-list" class="browser-list" />
            </ui:VisualElement>

            <ui:VisualElement name="details-panel" class="details-panel" style="display: none;">
                <ui:VisualElement class="details-panel__scrim" />
                <ui:VisualElement class="details-panel__card">
                    <ui:VisualElement name="detail-art-slot" class="details-panel__art" />
                    <ui:Label name="detail-new-badge" class="details-panel__new" style="display: none;" />
                    <ui:VisualElement name="detail-language-switcher" class="details-panel__languages" style="display: none;" />
                    <ui:Label name="detail-name" class="details-panel__name" />
                    <ui:Label name="detail-metadata" class="details-panel__metadata" />
                    <ui:Label name="detail-progress" class="details-panel__progress" />
                    <ui:Button name="details-close-button" class="browser-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
