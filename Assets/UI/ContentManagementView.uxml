<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Styles.uss" />
    <ui:VisualElement name="content-management" class="content-management-host">
        <ui:VisualElement name="content-shell" class="content-management__shell">
            <ui:VisualElement name="trainer-device-rail" class="trainer-device-rail">
                <ui:VisualElement class="trainer-device-rail__red" />
                <ui:VisualElement class="trainer-device-rail__yellow" />
                <ui:VisualElement class="trainer-device-rail__blue" />
            </ui:VisualElement>
            <ui:VisualElement class="content-management__header">
                <ui:VisualElement name="trainer-status-lights" class="trainer-status-lights">
                    <ui:VisualElement class="trainer-status-light trainer-status-light--lens" />
                    <ui:VisualElement class="trainer-status-light trainer-status-light--red" />
                    <ui:VisualElement class="trainer-status-light trainer-status-light--yellow" />
                    <ui:VisualElement class="trainer-status-light trainer-status-light--green" />
                </ui:VisualElement>
                <ui:VisualElement class="content-management__heading">
                    <ui:Label name="content-title" class="content-management__title" />
                    <ui:Label name="content-subtitle" class="content-management__subtitle" />
                </ui:VisualElement>
                <ui:VisualElement class="content-management__header-actions">
                    <ui:VisualElement name="refresh-button" class="content-button content-button--quiet" focusable="true">
                        <ui:Label name="refresh-button-label" class="content-button__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="back-button" class="content-button" focusable="true">
                        <ui:Label name="back-button-label" class="content-button__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="catalog-status" class="content-management__catalog-status" />
            <ui:VisualElement name="content-launch-banner" class="content-management__launch mobile-card">
                <ui:Label name="content-launch-title" class="content-management__launch-title" />
                <ui:Label name="content-launch-body" class="content-management__launch-body" />
                <ui:VisualElement name="content-launch-clear" class="content-button content-button--quiet"><ui:Label class="content-button__label" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="content-error-panel" class="player-error-panel is-hidden">
                <ui:Label name="content-error-title" class="player-error-panel__title" />
                <ui:Label name="content-error-body" class="player-error-panel__body" />
                <ui:VisualElement class="player-error-panel__actions">
                    <ui:VisualElement name="content-error-retry" class="content-button content-button--primary" focusable="true"><ui:Label class="content-button__label" /></ui:VisualElement>
                    <ui:VisualElement name="content-error-home" class="content-button content-button--quiet" focusable="true"><ui:Label class="content-button__label" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="content-filters" class="content-management__filters">
                <ui:TextField name="content-search" class="content-management__search" />
                <ui:DropdownField name="content-language-filter" class="content-management__filter" />
                <ui:DropdownField name="content-generation-filter" class="content-management__filter" />
                <ui:DropdownField name="content-install-filter" class="content-management__filter" />
            </ui:VisualElement>
            <ui:VisualElement name="content-selection" class="content-management__selection">
                <ui:Label name="content-selection-summary" class="content-management__selection-summary" />
                <ui:Toggle name="content-wifi-only" class="content-management__wifi-only" />
                <ui:VisualElement name="content-selection-actions" class="content-management__selection-actions">
                    <ui:VisualElement name="select-filtered-button" class="content-button content-button--quiet"><ui:Label class="content-button__label" /></ui:VisualElement>
                    <ui:VisualElement name="clear-selection-button" class="content-button content-button--quiet"><ui:Label class="content-button__label" /></ui:VisualElement>
                    <ui:VisualElement name="download-selected-button" class="content-button content-button--primary"><ui:Label class="content-button__label" /></ui:VisualElement>
                    <ui:VisualElement name="queue-pause-button" class="content-button content-button--quiet"><ui:Label class="content-button__label" /></ui:VisualElement>
                    <ui:VisualElement name="queue-resume-button" class="content-button content-button--quiet"><ui:Label class="content-button__label" /></ui:VisualElement>
                    <ui:VisualElement name="queue-retry-button" class="content-button content-button--quiet"><ui:Label class="content-button__label" /></ui:VisualElement>
                    <ui:VisualElement name="queue-cancel-button" class="content-button content-button--danger"><ui:Label class="content-button__label" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="content-empty" class="content-management__empty" />
            <ui:ListView name="package-list" class="content-management__list" virtualization-method="DynamicHeight" selection-type="None" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
